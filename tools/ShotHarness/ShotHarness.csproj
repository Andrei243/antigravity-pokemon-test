<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development tool: renders the game in a hidden window and saves screenshots for visual checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- For reading the pixels of two shots when comparing them -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../PokemonPlatinumEngine/PokemonPlatinumEngine.csproj" />
    <!-- The online server, started in-process on localhost by the `globallink` mode alone (plan 07 · O5), as the tests start it -->
    <ProjectReference Include="../../server/PokemonPlatinum.Server/PokemonPlatinum.Server.csproj" />
    <!-- The open world's baker and the prototype's rules, which the `openproto` mode and `profile`'s open_prototype bake and draw (plan 32 · OW0) -->
    <ProjectReference Include="../OpenWorldBake/OpenWorldBake.csproj" />
  </ItemGroup>

  <!-- The kept scenarios (plan 16 · T17), which the `scenarios` mode plays -->
  <ItemGroup>
    <None Include="scenarios\*.scn" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
