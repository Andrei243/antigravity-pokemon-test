# LS11a: Shaymin in Flower Paradise, at the beat's three moments and the battle's opening
newgame
flag FLAG_GAME_COMPLETED on
pokemon Garchomp 70
var VAR_HIDDEN_LOCATION_SEABREAK_PATH 4136
var VAR_SHAYMIN_EVENT_STATE 2
warp Sinnoh 911 205 up
wait 1
step up 1
wait 0.5
shot scn_ls11a_shaymin_0_meadow
talk
wait 1.0
shot scn_ls11a_shaymin_1_look
wait 1.4
shot scn_ls11a_shaymin_2_sign
wait 1.6
shot scn_ls11a_shaymin_3_voice
read
wait 4.5
shot scn_ls11a_shaymin_4_battle
