<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development tool: first-draft 3D sculpts of the new species, made by Tripo's image-to-model API from the concept
       pictures of tools/GeminiArt, to be cleaned up in Blender and dropped into overrides/models. No window, no engine,
       nothing shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
