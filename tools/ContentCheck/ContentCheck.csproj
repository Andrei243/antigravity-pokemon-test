<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development tool: reads the overlays, rooms and scripts written by hand and names what is wrong with them
       (plan 16 · T8); asked for a plan, it draws a room or an open area from above. No window: its checks are
       classes the test project drives. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../PokemonPlatinumEngine/PokemonPlatinumEngine.csproj" />
    <!-- The open regions' descriptions read as the baker reads them, and their land's field (plan 32 · OW5) -->
    <ProjectReference Include="../OpenWorldBake/OpenWorldBake.csproj" />
  </ItemGroup>

</Project>
