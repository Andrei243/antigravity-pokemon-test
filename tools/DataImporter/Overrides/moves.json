// Hand corrections to moves.json: a name maps to the fields to change (null removes one).
{
  // PokeAPI gives Sappy Seed (a move of Let's Go, Pikachu! and Eevee!) the effect of Pound, so the import names it
  // so; it is Leech Seed after its hit (Showdown's sappyseed), which the engine runs as its own effect (plan 06 ·
  // R25's leftovers)
  "Sappy Seed": {
    "effect": "SappySeed",
    "support": "Full"
  },
  // PokeAPI's side effect for Burning Jealousy is a burn every time; Showdown burns only a target whose stats rose
  // this turn, which the engine's code for the move decides (plan 06 · R26)
  "Burning Jealousy": {
    "inflictStatus": null,
    "statusChancePercent": null
  },
  // Who a move of Sword and Shield's or Legends: Arceus's is for, where PokeAPI's target and Showdown's part (plan 06
  // · R26): Coaching is for the ally beside its user (adjacentAlly), Lunar Blessing for its user and its allies
  // (allies), Take Heart for its user alone (self)
  "Coaching": {
    "target": "Ally"
  },
  "Lunar Blessing": {
    "target": "UserAndAllies"
  },
  "Take Heart": {
    "target": "User"
  }
}
