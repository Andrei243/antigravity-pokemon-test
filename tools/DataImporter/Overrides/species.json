// Hand corrections to species.json: a name maps to the fields to change.
{
  // Generation 5 on, Feebas also evolves when traded holding a Prism Scale (plan 06 · R28b); Platinum has only its beauty.
  // PokeAPI keeps that row with the later evolutions, which the importer reads only for species after Platinum's
  "Feebas": {
    "evolutions": [
      { "method": "Beauty", "targetSpecies": "Milotic", "value": 170 },
      { "method": "TradeHoldingItem", "targetSpecies": "Milotic", "item": "Prism Scale" }
    ]
  },
  // Solgaleo in Sun and Sword, Lunala in Moon and Shield. This game has no versions, so the hour decides:
  // the sun's by day, the moon's at night (docs/mechanics/rulings.md)
  "Cosmoem": {
    "evolutions": [
      { "method": "LevelDay", "targetSpecies": "Solgaleo", "level": 53 },
      { "method": "LevelNight", "targetSpecies": "Lunala", "level": 53 }
    ]
  },
  // PokeAPI's table gives Crabrawler nothing before level 5 in its newest game, where it starts with Vise Grip:
  // one hatched at level 1 knew a Tackle it never learns (plan 03 · D13, the full-dex check)
  "Crabrawler": {
    "learnset": [
      { "level": 1, "moveName": "Vise Grip" },
      { "level": 5, "moveName": "Rock Smash" },
      { "level": 9, "moveName": "Leer" },
      { "level": 13, "moveName": "Bubble Beam" },
      { "level": 17, "moveName": "Protect" },
      { "level": 22, "moveName": "Brick Break" },
      { "level": 25, "moveName": "Slam" },
      { "level": 29, "moveName": "Payback" },
      { "level": 33, "moveName": "Reversal" },
      { "level": 37, "moveName": "Crabhammer" },
      { "level": 42, "moveName": "Iron Defense" },
      { "level": 45, "moveName": "Dynamic Punch" },
      { "level": 49, "moveName": "Close Combat" }
    ]
  }
}
