// Hand corrections to items.json: a name maps to the fields to change; a name the import doesn't have is a new item.
{
  // Platinum gives running shoes as a feature, not an item; this game keeps them in the Key Items pocket
  "Running Shoes": {
    "id": 9000,
    "pocket": "KeyItems",
    "effectType": "KeyItem",
    "effectValue": 0,
    "price": 0,
    "canUseInBattle": false,
    "canUseInOverworld": true,
    "description": "Shoes for running: hold B, X or Shift to move at speed."
  },
  // A key item made for this game; nothing gives it yet
  "Distortion Orb": {
    "id": 9001,
    "pocket": "KeyItems",
    "effectType": "KeyItem",
    "effectValue": 0,
    "price": 0,
    "canUseInBattle": false,
    "canUseInOverworld": true,
    "description": "A dark orb that seems to pull at the space around it."
  },
  // The orbs of Primal Reversion (plan 06 · R20): PokeAPI's words are a story's; ours say what they do when held
  "Blue Orb": {
    "description": "Held by Kyogre, it brings out its primal form when it enters battle."
  },
  "Red Orb": {
    "description": "Held by Groudon, it brings out its primal form when it enters battle."
  },
  // The ring of Z-Moves (plan 06 · R21): our own words for what it does
  "Z-Ring": {
    "description": "A ring that lets the player's Pokémon unleash one Z-Move a battle through a held Z-Crystal."
  },
  // The band of Dynamax (plan 06 · R22): our own words for what it does
  "Dynamax Band": {
    "description": "A band that lets one of the player's Pokémon a battle Dynamax, growing huge for three turns."
  },
  // The orb of Terastallization (plan 06 · R23): our own words for what it does
  "Tera Orb": {
    "description": "An orb that lets one of the player's Pokémon a battle Terastallize, shining in its Tera Type."
  },
  // Johto's balls and the Park Ball (plan 06 · R28a): PokeAPI's words name the Apricorns and the old games; ours say
