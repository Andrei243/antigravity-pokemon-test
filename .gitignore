# Build output
bin/
obj/

# Visual Studio / IDE state
.vs/
*.user
*.suo

# Test results
TestResults/

# Local game saves
savegame.json
settings.json
# (but not Claude Code's project settings, which run tools/dev/session-start.sh: plan 16 · T16)
!.claude/settings.json
# (nor the editor's map of the data files to their schemas: plan 24 · X4)
!.vscode/settings.json

# What a run of the game and a crash leave beside the save (plan 16 · T3)
log.txt
log.1.txt
**/logs/crash-*.txt
**/logs/crash.pending
savegame.crash.json
savegame.crash.bak

# The battles a run kept on the Vs. Recorder, beside the save (plan 08 · P10)
/replays/
/PokemonPlatinumEngine/replays/

# The slots a game is saved in where the saves are kept beside the game, a developer's among them (plan 12 · Q2),
# with what a save and the old save's move leave for a moment, the old save's backup, and the marker that keeps them here
save[1-3].json
save[1-3].bak
save[1-3].json.tmp
autosave.json
savegame.bak
savegame.json.tmp
savegame.moving
portable.txt

# Hand-made art that replaces generated art (plan 04: overrides/sprites, overrides/models)
overrides/

# Models built from the Blender sculpts (plan 48 · BL1): made by `tools/BlenderAnim sculpt`, published with the game, never in git
/built/

# The people's files (plan 47): built with Blender by tools/dev/people.sh and by the release workflow, never in git
/assets/characters/

# Voice packs (plan 26 · V2): voice/<language>/ at the repository's root or beside the game, a separate download, never in git
/voice/
# The voice engine chosen by plan 26's trials: its own folder and settings on the user's machine, never in git
/tools/VoiceGen/engine.json
/tools/VoiceGen/env/

# The data importer's hand corrections are part of the repository
!tools/DataImporter/Overrides/

# What a golden file's check found the code giving instead (plan 24 · X2): looked at, then accepted or thrown away
*.received.txt

# The damage oracle's calculator (plan 24 · X6), fetched by `npm ci`: only its answers are committed
node_modules/

# The player's own files, read and never written (plan 08 · P20): saves and Pokémon files dropped here for the migration
migrate/

# What Python leaves beside tools/BlenderAnim's scripts when Blender imports one from another
__pycache__/
tools/GeminiArt/.cache/

# The bake of the baker's own test worlds (plan 32 · OW2): made again by `dotnet run --project tools/OpenWorldBake -- lab`;
# a region of the game commits its bake (PokemonPlatinumEngine/Data/world3d/<region>/baked)
tools/OpenWorldBake/worlds/*/baked/
