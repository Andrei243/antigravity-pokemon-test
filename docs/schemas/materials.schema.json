              "Fire",
              "Water",
              "Grass",
              "Electric",
              "Ice",
              "Fighting",
              "Poison",
              "Ground",
              "Flying",
              "Psychic",
              "Bug",
              "Rock",
              "Ghost",
              "Dragon",
              "Steel",
              "Dark",
              "Fairy",
              null
