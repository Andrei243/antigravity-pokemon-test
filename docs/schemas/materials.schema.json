        },
        "secondTypeInHundred": {
          "type": "integer"
        },
        "rareInHundred": {
          "type": "integer"
        },
        "rareLevelStep": {
          "type": "integer"
        },
        "rareInHundredMost": {
          "type": "integer"
        },
        "rareDoubleLevel": {
          "type": "integer"
        },
        "secondRareInThree": {
          "type": "integer"
        }
      },
