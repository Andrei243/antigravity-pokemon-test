<?xml version="1.0" encoding="utf-8"?>
<!-- A player's build for osx-x64 (plan 16 · T2): one executable with the .NET runtime and raylib inside it, the game's
     Data and Assets beside it. dotnet publish PokemonPlatinumEngine -p:PublishProfile=osx-x64 [-p:Version=0.1.0];
     .github/workflows/release.yml does it for a tag and zips the folder with the shipped mesh cache. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>bin/publish/osx-x64/</PublishDir>
    <ShippedBuild>true</ShippedBuild>
  </PropertyGroup>
</Project>