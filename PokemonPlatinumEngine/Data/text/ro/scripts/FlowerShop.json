{
  "Berry": [
    {
      "en": [
        "Plant a single berry and it grows into a plant that bears a handful more.",
        "So every berry that goes into the ground means more berries in the world. Do help us spread them everywhere!"
      ],
      "text": [
        "Plantezi o singură Boabă și crește o plantă care face încă un pumn de Boabe.",
        "Deci fiecare Boabă pusă în pământ înseamnă mai multe Boabe pe lume. Ajută-ne să le răspândim peste tot!"
      ]
    },
    {
      "en": [
        "Do plant that berry somewhere the soil is soft and loamy.",
        "Come by again tomorrow and I'll have a different one for you."
      ],
      "text": [
        "Plantează Boaba asta undeva unde pământul e moale și afânat.",
        "Mai treci și mâine și o să am alta pentru tine."
      ]
    }
  ],
  "Sprayduck": [
