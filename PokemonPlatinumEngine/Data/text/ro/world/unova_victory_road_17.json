          "Claude"
        ],
        "text": [
          "Claude"
        ]
      },
      "before": {
        "en": [
          "I've walked this road forty years. Let's see how far you've walked!"
        ],
        "text": [
          "Merg pe drumul ăsta de patruzeci de ani. Să vedem cât ai mers tu!"
        ]
      },
      "after": {
        "en": [
          "Further than me, it seems."
        ],
        "text": [
          "Mai departe decât mine, se pare."
        ]
      }
    },
    "3": {
      "name": {
        "en": [
          "Cecile"
        ],
        "text": [
          "Cecile"
        ]
      },
      "before": {
        "en": [
          "My husband and I train together. Now you get both of us, one at a time!"
        ],
        "text": [
          "Eu și soțul meu ne antrenăm împreună. Acum îi înfrunți pe amândoi, pe rând!"
        ]
      },
      "after": {
        "en": [
          "Well, that was humbling."
        ],
        "text": [
          "Ei bine, asta a fost umilitor."
        ]
      }
    },
