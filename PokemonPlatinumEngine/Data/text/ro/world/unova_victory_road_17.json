        "en": [
          "Billy"
        ],
        "text": [
          "Billy"
        ]
      },
      "before": {
        "en": [
          "Halfway to the League and already tired? Not me. Battle!"
        ],
        "text": [
          "La jumătatea drumului spre Ligă și deja obosit? Nu eu. Luptă!"
        ]
      },
      "after": {
        "en": [
          "Now I'm tired."
        ],
        "text": [
          "Acum sunt obosit."
        ]
      }
    },
