    "guard": {
      "name": {
        "en": [
          "Guard"
        ],
        "text": [
          "Paznicul"
        ]
      },
      "dialog": {
        "en": [
          "The tower is closed to visitors today. Its Gym Leader is busy with one of his inventions again."
        ],
        "text": [
          "Turnul e închis pentru vizitatori azi. Liderul lui de Arenă e iar ocupat cu una dintre invențiile sale."
        ]
      }
    },
    "artist": {
      "name": {
        "en": [
          "Artist"
        ],
        "text": [
          "Artistul"
        ]
      },
      "dialog": {
        "en": [
          "Vert Plaza in the morning light... Every painter in Kalos comes to Lumiose at least once."
        ],
        "text": [
          "Piața Vert în lumina dimineții... Fiecare pictor din Kalos vine la Lumiose măcar o dată."
        ]
      }
    },
    "tourist": {
      "name": {
        "en": [
          "Tourist"
        ],
        "text": [
          "Turistul"
        ]
      },
      "dialog": {
        "en": [
          "I came all this way to see the tower, and now I can't stop looking at the shop windows instead!"
        ],
        "text": [
          "Am venit de-atât de departe să văd turnul și acum nu mă mai pot dezlipi de vitrinele magazinelor!"
        ]
      }
    },
    "boy": {
      "name": {
        "en": [
          "Boy"
        ],
        "text": [
          "Băiatul"
        ]
      },
      "dialog": {
        "en": [
          "Lumiose is so big I got lost twice this morning. Just follow the avenues back to the tower!"
        ],
        "text": [
          "Lumiose e atât de mare, că m-am rătăcit de două ori azi-dimineață. Urmează bulevardele înapoi spre turn!"
        ]
      }
    },
    "gentleman": {
      "name": {
        "en": [
          "Gentleman"
        ],
        "text": [
          "Gentlemanul"
        ]
      },
      "dialog": {
        "en": [
          "Five plazas, five colours. Jaune is yellow, the colour of good fortune, or so my grandmother said."
        ],
        "text": [
          "Cinci piețe, cinci culori. Jaune e galben, culoarea norocului, așa zicea bunica."
        ]
      }
    },
    "waiter": {
      "name": {
        "en": [
          "Waiter"
        ],
        "text": [
          "Chelnerul"
        ]
      },
      "dialog": {
        "en": [
          "The café behind me belongs to a very important gentleman. Do mind your manners inside."
        ],
        "text": [
          "Cafeneaua din spatele meu aparține unui domn foarte important. Să te porți frumos înăuntru."
        ]
      }
    },
    "lady": {
      "name": {
        "en": [
          "Lady"
        ],
        "text": [
          "Doamna"
        ]
      },
      "dialog": {
        "en": [
          "The boutiques on this side of town are terribly grand. One day I'll be brave enough to go in."
        ],
        "text": [
          "Buticurile din partea asta a orașului sunt grozav de rafinate. Într-o zi voi avea curajul să intru."
        ]
      }
    },
    "lift_operator": {
      "name": {
        "en": [
          "Lift Operator"
        ],
        "text": [
          "Operatorul liftului"
        ]
      }
    },
    "lass": {
      "name": {
        "en": [
          "Lass"
        ],
        "text": [
          "Domnișoara"
        ]
      },
      "dialog": {
        "en": [
          "Every road out of Lumiose goes somewhere lovely. Today I'm skating west to Camphrier!"
        ],
        "text": [
          "Fiecare drum care pleacă din Lumiose duce undeva frumos. Azi patinez spre vest, la Camphrier!"
        ]
      }
    },
