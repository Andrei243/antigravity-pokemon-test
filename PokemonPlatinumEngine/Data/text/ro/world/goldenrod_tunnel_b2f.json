{
  "people": {
    "d37r0104_rocketm": {
      "name": {
        "en": [
          "Grunt"
        ],
        "text": [
          "Grunt"
        ]
      },
      "before": {
        "en": [
          "Grunt: A kid, down here? Somebody's let you wander a long way from home."
        ],
        "text": [
          "Grunt: Un copil, aici jos? Cineva te-a lăsat să te rătăcești departe de casă."
        ]
      },
      "after": {
        "en": [
          "Grunt: Fine, go on, get lost in the shutters for all I care."
        ],
        "text": [
          "Grunt: Bine, hai, pierde-te printre oblonuri, nu-mi pasă."
        ]
      }
    },
    "d37r0104_rocketm_2": {
      "name": {
        "en": [
          "Grunt"
        ],
        "text": [
          "Grunt"
        ]
      },
      "before": {
        "en": [
          "Grunt: These passages are ours now. Turn round!"
        ],
        "text": [
          "Grunt: Pasajele astea sunt ale noastre acum. Întoarce-te!"
        ]
      },
      "after": {
        "en": [
          "Grunt: Ours... for about another minute, it seems."
        ],
        "text": [
          "Grunt: Ale noastre... încă vreun minut, se pare."
        ]
      }
    },
    "d37r0104_rocketm_3": {
      "name": {
        "en": [
          "Grunt"
        ],
        "text": [
          "Grunt"
        ]
      },
      "before": {
        "en": [
          "Grunt: The switches? Don't you dare touch them!"
        ],
        "text": [
          "Grunt: Comutatoarele? Să nu îndrăznești să le atingi!"
        ]
      },
      "after": {
        "en": [
          "Grunt: Go on, then. See if you can make sense of them."
        ],
        "text": [
          "Grunt: Hai, atunci. Vezi dacă le pricepi."
        ]
      }
    },
    "d37r0104_rocketw": {
      "name": {
        "en": [
          "Grunt"
        ],
        "text": [
          "Grunt"
        ]
      },
      "before": {
        "en": [
          "Grunt: Nobody goes near the warehouse. Boss's orders!"
        ],
        "text": [
          "Grunt: Nimeni nu se apropie de depozit. Ordinul șefului!"
        ]
      },
      "after": {
        "en": [
          "Grunt: The boss isn't going to like this one bit."
        ],
        "text": [
          "Grunt: Șefului nu-i va plăcea deloc asta."
        ]
      }
    },
    "d37r0104_thief": {
      "name": {
        "en": [
          "Orson"
        ],
        "text": [
          "Orson"
        ]
      },
      "before": {
        "en": [
          "Burglar Orson: With Team Rocket keeping everyone busy, a fellow can pick up all sorts down here."
        ],
        "text": [
          "Hoț Orson: Cu Echipa Rocket ținând pe toată lumea ocupată, un tip găsește tot felul de lucruri pe aici."
        ]
      },
      "after": {
        "en": [
          "Burglar Orson: I'll find something else to pick up. Not a fight, though."
        ],
        "text": [
          "Hoț Orson: Voi găsi altceva de luat. Dar nu o luptă."
        ]
      }
    },
    "d37r0104_thief_2": {
      "name": {
        "en": [
          "Duncan"
        ],
        "text": [
          "Duncan"
        ]
      },
      "before": {
        "en": [
          "Burglar Duncan: Hand over your money and nobody needs to battle!"
        ],
        "text": [
          "Hoț Duncan: Dă banii și nimeni nu trebuie să lupte!"
        ]
      },
      "after": {
        "en": [
          "Burglar Duncan: I should have just stuck to the shops."
        ],
        "text": [
          "Hoț Duncan: Trebuia să mă țin de magazine."
        ]
      }
    },
