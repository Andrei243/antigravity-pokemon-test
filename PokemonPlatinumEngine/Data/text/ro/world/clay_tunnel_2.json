      "before": {
        "en": [
          "You can tell how deep a tunnel goes by how tired the workers are. I'm wide awake!"
        ],
        "text": [
          "Adâncimea unui tunel se vede după cât de obosiți sunt muncitorii. Eu sunt treaz de-a binelea!"
        ]
      },
      "after": {
        "en": [
          "Now I'm tired."
        ],
        "text": [
          "Acum sunt obosit."
        ]
