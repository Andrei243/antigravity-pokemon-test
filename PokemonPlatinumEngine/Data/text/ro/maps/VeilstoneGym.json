    "black_belt_colby": {
      "name": {
        "en": [
          "Colby"
        ],
        "text": [
          "Colby"
        ]
      },
      "before": {
        "en": [
          "Black Belt Colby: This ring is where we sharpen ourselves. Step in, if you dare!"
        ],
        "text": [
          "Centură Neagră Colby: Ringul ăsta e locul unde ne ascuțim. Intră, dacă ai curaj!"
        ]
      },
      "after": {
        "en": [
          "Black Belt Colby: My guard was down... The bags will show you the way through. Hit them true."
        ],
        "text": [
          "Centură Neagră Colby: Am lăsat garda jos... Sacii îți vor arăta drumul. Lovește-i drept."
        ]
      }
    },
    "black_belt_darren": {
      "name": {
        "en": [
          "Darren"
        ],
        "text": [
          "Darren"
        ]
      },
      "before": {
        "en": [
          "Black Belt Darren: I see everything from inside this ring. Including you!"
        ],
        "text": [
          "Centură Neagră Darren: Văd totul din ringul ăsta. Inclusiv pe tine!"
        ]
      },
      "after": {
        "en": [
          "Black Belt Darren: Beaten fair and square. Your Pokémon fight with real spirit."
        ],
        "text": [
          "Centură Neagră Darren: Învins cinstit. Pokémonii tăi luptă cu adevărat cu suflet."
        ]
      }
    },
    "black_belt_jeffery": {
      "name": {
        "en": [
          "Jeffery"
        ],
        "text": [
          "Jeffery"
        ]
      },
      "before": {
        "en": [
          "Black Belt Jeffery: You've come all this way round? Then you'll have to come through me as well!"
        ],
        "text": [
          "Centură Neagră Jeffery: Ai făcut tot ocolul ăsta? Atunci va trebui să treci și de mine!"
        ]
      },
      "after": {
        "en": [
          "Black Belt Jeffery: Ugh... Maylene trains harder than all of us put together. Good luck."
        ],
        "text": [
          "Centură Neagră Jeffery: Of... Maylene se antrenează mai mult decât noi toți la un loc. Baftă."
        ]
      }
    },
    "black_belt_rafael": {
      "name": {
        "en": [
          "Rafael"
        ],
        "text": [
          "Rafael"
        ]
      },
      "before": {
        "en": [
          "Black Belt Rafael: Kick a bag and it flies along its track! But you'll have to beat me before you get any further."
        ],
        "text": [
          "Centură Neagră Rafael: Dă un șut unui sac și zboară pe șina lui! Dar va trebui să mă învingi înainte să mergi mai departe."
        ]
      },
      "after": {
        "en": [
          "Black Belt Rafael: Hoo! You hit harder than any bag I've ever kicked."
        ],
        "text": [
          "Centură Neagră Rafael: Huh! Lovești mai tare decât orice sac în care am dat vreodată."
        ]
      }
    },
