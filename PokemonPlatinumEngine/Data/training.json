{
  // The training club's tables (plan 36 · TR2; docs/data-files.md, "Training"): ours, written by hand and read strictly.
  // A stat's first gold in the drills gives its vitamin; once a Hall of Fame has been entered every tenth gold gives a
  // Bottle Cap and every fiftieth a Gold Bottle Cap. The coach hands over what is owed when spoken to.
  "drillPrizes": {
    "firstGold": [
      { "stat": "HP", "item": "HP Up" },
      { "stat": "Attack", "item": "Protein" },
      { "stat": "Defense", "item": "Iron" },
      { "stat": "SpAttack", "item": "Calcium" },
      { "stat": "SpDefense", "item": "Zinc" },
      { "stat": "Speed", "item": "Carbos" }
    ],
    "everyGolds": [
      { "golds": 10, "item": "Bottle Cap", "afterHallOfFame": true },
      { "golds": 50, "item": "Gold Bottle Cap", "afterHallOfFame": true }
    ],
    // With a Tera Orb in the bag (plan 36 · TR5), every fifth gold earns a Tera Shard of the trainee's own first type
    "teraShardEvery": 5
  },
  // What the training club's clerk at a Battle Points counter trades (plan 36 · TR3): a third list beside the Exchange Service
  // Corner's two (frontier prize training), on the Frontier's one set of points, at prices of ours on Platinum's scale
  // (its held items cost 16 to 48). Sinnoh's Frontier grounds, Hoenn's island counter and the Gear Station each have the clerk
  "battlePoints": [
    { "item": "Bottle Cap", "price": 48 },
    { "item": "Gold Bottle Cap", "price": 160 },
    { "item": "Ability Capsule", "price": 48 },
    { "item": "Ability Patch", "price": 200 },
