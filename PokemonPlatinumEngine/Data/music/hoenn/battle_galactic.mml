# A battle with Team Aqua (Emerald's battle with the teams): a churning minor-key riff in D minor, pulse lead and
# brass hits over a galloping synth bass, with a bridge that lurches up a half step. Original composition for this
# game (plan 21 · H2, part b).
title Battle! Team Aqua
tempo 156
meter 4/4
lowhptempo 1.07
reverb 0.16

track lead pulse lowhp=sawlead vol=0.72 pan=0.05 rev=0.18
  o5 d8 r8 d8 r8 f8 r8 a8 r8 | o5 d8 r8 d8 r8 c+4 c+4 | L o5 d4 f8 a8 o6 d4 o5 a4 | o5 b-4 o6 d8 f8 d4 o5 b-4 |
  o5 g4 b-8 o6 d8 o5 b-4 g4 | o5 a4 c+8 e8 a4 e4 | o5 d4 f8 a8 o6 d4 o5 a4 | o5 b-4 g8 b-8 o6 d4 o5 b-4 |
  o5 a4 c+8 e8 a4 c+4 | o5 d2 d4 r4 |

track brass brass unless=lowhp vol=0.32 pan=-0.25 rev=0.2
  o4 (d f a)8 r8 (d f a)8 r8 (d f a)8 r8 (d f a)8 r8 | (d f a)8 r8 (d f a)8 r8 (a >c+ e)4 (a >c+ e)4 | L o4 (d f a)1 | (b- >d f)1 |
  (g b- >d)1 | (a >c+ e)1 | (d f a)1 | (g b- >d)1 |
  (a >c+ e)1 | (d f a)1 |

track bass synthbass vol=0.7 rev=0.05
  o3 d8 r8 d8 r8 d8 r8 d8 r8 | o3 d8 r8 d8 r8 a4 a4 | L [ o2 d8 o3 d8 ]4 | [ o2 b-8 o3 b-8 ]4 |
  [ o2 g8 o3 g8 ]4 | [ o2 a8 o3 a8 ]4 | [ o2 d8 o3 d8 ]4 | [ o2 g8 o3 g8 ]4 |
  [ o2 a8 o3 a8 ]4 | [ o2 d8 o3 d8 ]4 |

track drums kit vol=0.5 rev=0.1
  v100 (b c)8 r8 b8 r8 (b c)8 r8 b8 r8 | (b c)8 r8 b8 r8 s16 s16 s16 s16 s8 s8 | L [ b8 b8 s8 b8 r8 b8 s8 r8 | ]7 b8 r8 s8 b8 s16 s16 s16 s16 s8 s8 |

track hats kit vol=0.4 pan=0.15 rev=0.1
  r1 | r1 | L v62 [ h8 v40 h8 v62 h8 v40 h8 v62 h8 v40 h8 v62 h8 v40 h8 v62 | ]8

# Low HP: two pips a beat, only while a Pokémon of the player's is in the red
track alarm pulse only=lowhp vol=0.5 pan=0.1 rev=0.08
  v110 r1 | r1 | L [ o6 d16 r16 d16 r16 r4 d16 r16 d16 r16 r4 | ]8

# Giant (plan Y · YD5): while a Dynamaxed Pokémon stands on the field, a choir on the tune,
# brass on the roots and timpani on the bass's beats
track giantchoir choir only=giant double=lead shift=-12 vol=0.2 pan=-0.25 rev=0.4
track giantbrass brass only=giant double=bass beats=4 shift=24 vol=0.22 pan=0.25 rev=0.28
track gianttimpani timpani only=giant double=bass beats=4 shift=24 vol=0.32 rev=0.2
