# Low HP: the alarm figure, two pips on each first beat, only while a Pokémon of the player's is in the red
track alarm pulse only=lowhp vol=0.5 pan=0.1 rev=0.08
  v110 r2. | r2. |
  L [ o6 g16 r16 g16 r16 r2 | ]16

# Giant (plan Y · YD5): while a Dynamaxed Pokémon stands on the field, a choir under the tune and timpani on the bass's beats
track giantchoir choir only=giant double=lead shift=-12 vol=0.2 pan=-0.25 rev=0.4
track gianttimpani timpani only=giant double=bass beats=4 shift=12 vol=0.32 rev=0.2
