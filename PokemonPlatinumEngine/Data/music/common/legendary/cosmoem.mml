  r1 | r1 | L [ v80 g8 v50 g8 v90 d8 v50 g8 v80 g8 v50 g8 v90 d8 v60 n16 n16 | ]16

# Low HP: the alarm figure, two pips a beat, only while a Pokémon of the player's is in the red
track alarm pulse only=lowhp vol=0.42 pan=0.1 rev=0.08
  v110 r1 | r1 | L [ o6 f16 r16 f16 r16 r4 f16 r16 f16 r16 r4 | ]16

# Giant (plan Y · YD5): while a Dynamaxed Pokémon stands on the field, a choir on the chords,
# brass on the roots and timpani on the bass's beats
track giantchoir choir only=giant double=pad vol=0.2 pan=-0.25 rev=0.4
track giantbrass brass only=giant double=bass beats=4 shift=12 vol=0.22 pan=0.25 rev=0.28
track gianttimpani timpani only=giant double=bass beats=4 shift=12 vol=0.32 rev=0.2
