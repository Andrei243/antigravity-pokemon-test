# The Regis' code: short-short-long in sixteenths, in bare fifths, on every beat
track code pulse vol=0.26 pan=0.3 rev=0.12
  o5 [ (d a)16 (d a)16 (d a)8 ]4 | o5 [ (a >e)16 (a >e)16 (a >e)8 ]4 |
  L o5 [ (d a)16 (d a)16 (d a)8 ]4 | o5 [ (d a)16 (d a)16 (d a)8 ]4 | o5 [ (b- >f)16 (b- >f)16 (b- >f)8 ]4 | o5 [ (c g)16 (c g)16 (c g)8 ]4 |
  o5 [ (d a)16 (d a)16 (d a)8 ]4 | o5 [ (f >c)16 (f >c)16 (f >c)8 ]4 | o5 [ (g >d)16 (g >d)16 (g >d)8 ]4 | o5 [ (a >e)16 (a >e)16 (a >e)8 ]4 |
  o5 [ (b- >f)16 (b- >f)16 (b- >f)8 ]4 | o5 [ (c g)16 (c g)16 (c g)8 ]4 | o5 [ (d a)16 (d a)16 (d a)8 ]4 | o5 [ (e- b-)16 (e- b-)16 (e- b-)8 ]4 |
  o5 [ (b- >f)16 (b- >f)16 (b- >f)8 ]4 | o5 [ (g >d)16 (g >d)16 (g >d)8 ]4 | o5 [ (a >e)16 (a >e)16 (a >e)8 ]4 | o5 [ (a >e)16 (a >e)16 (a >e)8 ]4 |

