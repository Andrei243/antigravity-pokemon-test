# A trainer of Unova (Black 2's trainer battle): a restless square lead in D minor over pounding octaves, climbing
# through B-flat and C before an A major turn throws it back to the start. Original composition for this game
# (plan 22 · U5).
title Battle! Trainer (Unova)
tempo 168
meter 4/4
lowhptempo 1.08
reverb 0.16

track lead square lowhp=sawlead vol=0.82 pan=0.05 rev=0.18
  o5 d8 f8 a8 o6 d8 c8 o5 a8 f8 e8 | o5 d2 a4 r4 | L o5 d4. e8 f4 a4 | o5 b-4 f8 g8 f4 d4 |
  o5 e4. g8 c4 e4 | o5 d2 a4 f4 | o5 a4. o6 c8 d4 f4 | o6 d4 c8 o5 b-8 g4 b-4 |
  o5 c+4 e8 a8 e4 c+4 | o5 d2 f2 |

track pad strings unless=lowhp vol=0.26 pan=-0.25 rev=0.22
  r1 | r1 | L o4 (d f a)1 | (b- d f)1 |
  (c e g)1 | (d f a)1 | (d f a)1 | (g b- d)1 |
  (a c+ e)1 | (d f a)1 |

track bass synthbass vol=0.68 rev=0.05
  o3 d8 o2 d8 o3 d8 o2 d8 o3 d8 o2 d8 o3 c8 o2 c8 | o2 d4 d4 a4 r4 | L [ o2 d8 o3 d8 ]4 | [ o2 b-8 o3 b-8 ]4 |
  [ o2 c8 o3 c8 ]4 | [ o2 d8 o3 d8 ]4 | [ o2 d8 o3 d8 ]4 | [ o2 g8 o3 g8 ]4 |
  [ o2 a8 o3 a8 ]4 | [ o2 d8 o3 d8 ]4 |

track drums kit vol=0.5 rev=0.1
  v95 b8 s8 b8 s8 b8 s8 b8 s8 | (b c)4 (b c)4 (b c)4 r4 | L [ b8 r8 s8 b8 r8 b8 s8 r8 | ]7 b8 r8 s8 b8 s16 s16 s16 s16 s8 s8 |

track hats kit vol=0.38 pan=0.15 rev=0.1
  r1 | r1 | L v60 [ h8 v38 h8 v60 h8 v38 h8 v60 h8 v38 h8 v60 h8 v38 h8 v60 | ]8

# Low HP: two pips a beat, only while a Pokémon of the player's is in the red
track alarm pulse only=lowhp vol=0.5 pan=0.1 rev=0.08
  v110 r1 | r1 | L [ o6 a16 r16 a16 r16 r4 a16 r16 a16 r16 r4 | ]8

# Giant (plan Y · YD5): while a Dynamaxed Pokémon stands on the field, a choir on the chords,
# brass on the roots and timpani on the bass's beats
track giantchoir choir only=giant double=pad vol=0.2 pan=-0.25 rev=0.4
track giantbrass brass only=giant double=bass beats=4 shift=24 vol=0.22 pan=0.25 rev=0.28
track gianttimpani timpani only=giant double=bass beats=4 shift=24 vol=0.32 rev=0.2
