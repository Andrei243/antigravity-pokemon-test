# A Gym Leader of Unova (Black 2's Gym Leader battle): a proud G minor theme, the square lead and a brass section
# trading blows over driving octaves, a D major turn that makes room for the next round. Original composition for
# this game (plan 22 · U5).
title Battle! Gym Leader (Unova)
tempo 160
meter 4/4
lowhptempo 1.08
reverb 0.18

track lead square lowhp=sawlead vol=0.8 pan=0.05 rev=0.2
  o5 g8 b-8 o6 d8 g8 f8 d8 o5 b-8 a8 | o5 g2 d4 r4 | L o5 g4. a8 b-4 o6 d4 | o6 e-4 o5 b-8 o6 c8 o5 b-4 g4 |
  o5 a4. c8 f4 a4 | o5 g2 d4 b-4 | o6 d4. e-8 d4 o5 b-4 | o6 c4 o5 b-8 a8 g4 o6 e-4 |
  o5 f+4 a8 o6 d8 o5 a4 f+4 | o5 g2 b-2 |

track pad brass unless=lowhp vol=0.26 pan=-0.25 rev=0.24
  r1 | r1 | L o4 (g b- d)1 | (e- g b-)1 |
  (f a c)1 | (g b- d)1 | (g b- d)1 | (c e- g)1 |
  (d f+ a)1 | (g b- d)1 |

track bass synthbass vol=0.68 rev=0.05
  o3 g8 o2 g8 o3 g8 o2 g8 o3 g8 o2 g8 o3 f8 o2 f8 | o2 g4 g4 d4 r4 | L [ o2 g8 o3 g8 ]4 | [ o2 e-8 o3 e-8 ]4 |
  [ o2 f8 o3 f8 ]4 | [ o2 g8 o3 g8 ]4 | [ o2 g8 o3 g8 ]4 | [ o2 c8 o3 c8 ]4 |
  [ o2 d8 o3 d8 ]4 | [ o2 g8 o3 g8 ]4 |

track drums kit vol=0.5 rev=0.1
  v95 b8 s8 b8 s8 b8 s8 b8 s8 | (b c)4 (b c)4 (b c)4 r4 | L [ b8 r8 s8 b8 r8 b8 s8 r8 | ]7 b8 r8 s8 b8 s16 s16 s16 s16 s8 s8 |

track hats kit vol=0.38 pan=0.15 rev=0.1
  r1 | r1 | L v60 [ h8 v38 h8 v60 h8 v38 h8 v60 h8 v38 h8 v60 h8 v38 h8 v60 | ]8

# Low HP: two pips a beat, only while a Pokémon of the player's is in the red
track alarm pulse only=lowhp vol=0.5 pan=0.1 rev=0.08
  v110 r1 | r1 | L [ o6 a16 r16 a16 r16 r4 a16 r16 a16 r16 r4 | ]8

# Giant (plan Y · YD5): while a Dynamaxed Pokémon stands on the field, a choir on the chords,
# brass on the roots and timpani on the bass's beats
track giantchoir choir only=giant double=pad vol=0.2 pan=-0.25 rev=0.4
track giantbrass brass only=giant double=bass beats=4 shift=24 vol=0.22 pan=0.25 rev=0.28
track gianttimpani timpani only=giant double=bass beats=4 shift=24 vol=0.32 rev=0.2
