  // What is built of Sinnoh so far. "maps" are the maps the game makes from the imported matrices; "areas" are
  // the areas that are open to walk in. After adding an area, run tools/MapImporter with --data and write its
  // overlay (overlays/<key>.json). A map whose "setting" is "Cave" is rock wherever nothing else is said: its
  // walls stand up from the floor, and no sky lights it. One whose "setting" is "Void" is nothing where nothing is
  // said: islands float over a drop nobody walks into (the Distortion World).
  "region": "Sinnoh",
  // Chunks the original leaves out (forest in their place) until the story reveals them: the Spring Path's four,
  // until VAR_HIDDEN_LOCATION_SPRING_PATH holds the original's number for it (0x0312), which the Distortion World's
  // end and the Hall of Fame set
  "hidden": [
    { "var": "VAR_HIDDEN_LOCATION_SPRING_PATH", "value": 786, "chunkX": 23, "chunkY": 21, "chunksWide": 2, "chunksHigh": 2 }
  ],
