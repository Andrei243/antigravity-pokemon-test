{
  "area": "route_201",
  "bgmTrack": "sinnoh/route201",
  "trees": "Round",
  "people": {
    // The chapter's people (scripts/route_201.txt; plan 02 · S4). In Platinum the professor hands out the first
    // Pokémon here, from his briefcase, not at the lake; his assistant brings the briefcase from the lake
    "rival": { "name": "{rival}", "script": "Rival" },
    "prof_rowan": { "name": "Prof. Rowan", "script": "Rowan" },
    "counterpart": { "name": "{assistant}", "npcType": "Assistant", "dialog": [ "{assistant}: Go on, {player}! The Pokémon are in the briefcase." ] },
    "briefcase": {
      "id": "starter_briefcase",
      "name": "Professor's Briefcase",
      "isStarterBriefcase": true,
      "script": "Briefcase"
    },
    "pokemon_breeder_m": {
      "name": "Breeder",
      "dialog": [
        "Pokémon grow stronger every time they battle.",
        "Walk through the tall grass and you'll never be short of wild ones to battle."
      ]
    },
    "cashier_m": {
      "name": "Mart Clerk",
      "script": "MartWorker",
      "dialog": [
        "I work at the Poké Mart in Sandgem Town, at the east end of this road.",
        "Come by when your Pokémon need Potions!"
      ]
    },
    "school_kid_m": {
      "name": "Schoolboy",
      "dialog": [
        "You can jump down a ledge, but you can't climb back up one.",
        "It's the quick way back toward Twinleaf Town."
      ]
    },
    "lass": {
      "name": "Lass",
      "dialog": [
        "Sandgem Town is where this road ends.",
        "The Professor's lab is the big building on your left as you come in."
      ]
    }
  },
  // The original's triggers: the professor's scene, the rival keeping the player at the briefcase, the road back
  // to the lake (and the two ways the player is turned back while the rival waits there)
  "triggers": [
    { "trigger": 0, "script": "RowanAppears" }, { "trigger": 1, "script": "ChooseFirst" }, { "trigger": 2, "script": "NotHome" },
    { "trigger": 3, "script": "ChooseFirst" }, { "trigger": 4, "script": "NotSandgem" }, { "trigger": 5, "script": "OffToTheLake" },
    // Ours, while the briefcase waits (VAR_FOLLOWER_RIVAL_STATE 1): the original's two hold only part of the grass's
    // edge, and a player with no Pokémon walked round them into the grass. With these the whole of its edge, the road
    // west to the lake and the road home turn the player back until a Pokémon is chosen.
    { "x": 115, "z": 852, "depth": 2, "variable": "VAR_FOLLOWER_RIVAL_STATE", "value": 1, "script": "ChooseFirst" },
    { "x": 115, "z": 855, "depth": 2, "variable": "VAR_FOLLOWER_RIVAL_STATE", "value": 1, "script": "ChooseFirst" },
    { "x": 103, "z": 853, "depth": 3, "variable": "VAR_FOLLOWER_RIVAL_STATE", "value": 1, "script": "ChooseFirstWest" },
    { "x": 110, "z": 858, "width": 4, "variable": "VAR_FOLLOWER_RIVAL_STATE", "value": 1, "script": "ChooseFirstSouth" }
  ],
  "signs": {
    "arrow_signpost_twinleaf_town": "Route 201\nSouth: Twinleaf Town",
    "arrow_signpost_sandgem_town": "Route 201\nEast: Sandgem Town",
    "trainer_tips_signpost": "Trainer Tips\nWild Pokémon live in tall grass. Weaken one in battle, then throw a Poké Ball to catch it."
  }
}
