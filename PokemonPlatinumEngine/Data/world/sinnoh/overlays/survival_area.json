    "rival": { "name": "{rival}", "script": "Rival", "still": true },
    "ruin_maniac": {
      "name": "Ruin Maniac",
      "dialog": [
        "The rock round here keeps marvellous things. I've chipped out prints of creatures nobody has seen alive!",
        "A day on this mountain beats a year in any museum."
      ]
    },
    "battle_girl": {
      "name": "Battle Girl",
      "dialog": [
        "Nobody comes to the Survival Area for the view. We come here to train!",
        "Cliffs to climb, a volcano up the road and the strongest trainers in the land next door. Hi-yah! Perfect!"
      ]
    },
    "youngster": {
      "name": "Youngster",
      "dialog": [
        "I packed my Bag so full of items for the routes round here that I can hardly lift it.",
        "I'm not taking a single one out, though. You'd be mad to set off from here without them!"
      ]
    },
    // Once Heatran has been battled in Stark Mountain he has another thing to say (plan 02 · S15, part b)
    "cameraman": {
      "name": "Cameraman",
      "npcType": "Gentleman",
      "script": "Cameraman",
      "dialog": [
        "I once filmed a red Gyarados! Biggest scoop of my life, and I've been after the next one ever since.",
        "They say something stirs inside the volcano up north. If it shows itself, my camera will be rolling."
      ]
    }
  },
  "signs": {
    "map_signpost": "Survival Area\nOnly the toughest stay."
  },
