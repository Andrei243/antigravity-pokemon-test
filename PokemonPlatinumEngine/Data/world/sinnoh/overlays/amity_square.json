    "receptionist_west": { "name": "Receptionist", "script": "ReceptionistWest", "still": true },
    "receptionist_east": { "name": "Receptionist", "script": "ReceptionistEast", "still": true },
    "pokemon_breeder_m": {
      "name": "Man",
      "dialog": [
        "The old stones round this square were standing long before anyone built Hearthome.",
        "Nobody knows who raised them. My Drifloon likes to float about them all afternoon."
      ]
    },
    "pokemon_breeder_f": {
      "name": "Woman",
      "dialog": [
        "My Happiny and I come here every single day.",
        "The fresh air does us both good. Then it naps all the way home."
      ]
    },
    "collector": {
      "name": "Man",
      "dialog": [
        "All my life I dreamt of strolling round this park with a Pikachu.",
        "And today, at last, here we are! I could burst!"
      ]
    },
    "twin": {
      "name": "Girl",
      "dialog": [
        "Do you talk to your Pokémon? You should!",
        "My Clefairy understands every word I say. Well, nearly every word."
      ]
    },
    // He gives away five of a berry or an accessory once a day, and stands somewhere else each visit (the square's own
    // arrival script draws both)
    "gift_man": { "name": "Man", "script": "GiftMan", "still": true }
  }
}
