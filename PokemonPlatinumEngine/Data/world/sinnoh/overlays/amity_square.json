{
  "area": "amity_square",
  "bgmTrack": "sinnoh/amity_square",
  // The great stones are the huts of the square's ruins (plan 06 · R16c): whoever stands in the middle of one and
  // steps north, west or east is carried to another's, which is the only way onto most of the raised ground: the
