  "trees": "Round",
  // Hearthome City's two gates, on the original's plan (plan 01 · M11, part d): a receptionist in each
  "doors": [
    { "warp": 0, "map": "HearthomeCityWestGateToAmitySquare", "x": 5, "y": 3, "facing": "Down" },
    { "warp": 1, "map": "HearthomeCityWestGateToAmitySquare", "x": 5, "y": 3, "facing": "Down" },
    { "warp": 2, "map": "HearthomeCityEastGateToAmitySquare", "x": 5, "y": 3, "facing": "Down" },
    { "warp": 3, "map": "HearthomeCityEastGateToAmitySquare", "x": 5, "y": 3, "facing": "Down" }
  ],
  "people": {
    // The Pokémon their trainers walk here (plan 10 · F1). The Happiny is drowsy and says so without a cry, as the
    // original's is
    "drifloon": { "name": "Drifloon", "dialog": [ "Fuwaaa..." ] },
    "pikachu": { "name": "Pikachu", "dialog": [ "Pika! Pikachu!" ] },
    "clefairy": { "name": "Clefairy", "dialog": [ "Clefairy is holding something shiny in both hands." ] },
    "happiny": { "name": "Happiny", "script": "Happiny", "still": true },
    // The Pokémon of the team that walks behind the player (plan 06 · R16c): the original gives this object its looks
    // by script, so it is made a Pokémon here and dressed as whoever is let out (it is a Pikachu until then, off the
    // map behind its flag). It follows the player: nothing else moves it
    "follower_mon": { "name": "Pokémon", "npcType": "Pokemon", "species": "Pikachu", "script": "FollowerMon", "still": true },
    // The two receptionists stand behind their counters inside the square: they ask whoever comes up from a gate which
