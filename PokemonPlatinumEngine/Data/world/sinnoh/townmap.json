    { "key": "berry_masters_house", "name": "Berry Master's House", "flag": "FLAG_FIRST_ARRIVAL_BERRY_MASTERS_HOUSE", "about": "Home of the Berry Master, an old man fond of nature, Pokémon and Berries." },
    { "key": "lost_tower", "name": "Lost Tower", "flag": "FLAG_FIRST_ARRIVAL_LOST_TOWER", "arrival": [ "LostTower1F" ], "about": "A tower where Pokémon are laid to rest at the end of their lives." },
