// The Town Map of Sinnoh (plan 01 · M12; docs/data-files.md, "The region map"): the map of the region as the game
// shows it, a cell for each chunk of the overworld. The blocks, their kinds, the flags a description waits for and the
// hidden places are the original's (res/town_map/town_map_data.json and src/applications/town_map of the pinned
// decompilation); the names are the world's own, and every line of text is ours, on the subjects the original has.
{
  "map": "Sinnoh",
  "columns": 30,
  "rows": 30,
  // What the screen shows of the grid: the empty north is left out (left, top, columns, rows)
  "view": [ 0, 5, 30, 24 ],
  // Where the cursor may go (the original's HandleInput: columns 1 to 28, rows 6 to 28), and where it stands when
  // the player is nowhere on the map (Twinleaf Town's cell)
  "cursor": [ 1, 6, 28, 28 ],
  "start": [ 3, 27 ],
  // Places left off the map until the story reveals them (SystemVars_CheckHiddenLocation); "sea" paints them as open
  // water until then, where the world has land there all along
  "hidden": [
    { "key": "fullmoon_island", "variable": "VAR_HIDDEN_LOCATION_FULL_MOON_ISLAND", "value": 520, "sea": true },
    { "key": "newmoon_island", "variable": "VAR_HIDDEN_LOCATION_NEW_MOON_ISLAND", "value": 553, "sea": true },
    { "key": "spring_path", "variable": "VAR_HIDDEN_LOCATION_SPRING_PATH", "value": 786 },
    { "key": "seabreak_path", "variable": "VAR_HIDDEN_LOCATION_SEABREAK_PATH", "value": 4136, "sea": true }
  ],
  // What is said of an area, and the flag its words wait for (a town's first arrival)
  "areas": [
    { "key": "route_201", "about": "A short road through deep green woods, where the air is heavy with the scent of the trees." },
    { "key": "route_202", "about": "A path that bends through open grass. New Trainers come here to try their first battles." },
    { "key": "route_203", "about": "A quiet stretch of country that keeps its calm, though the big city lies at its west end." },
    { "key": "route_204", "about": "An easy road that strolls past ponds and small stands of trees." },
    { "key": "route_205_north", "about": "A long boardwalk crosses a broad pond here, lined with anglers and their rods." },
    { "key": "route_205_south", "about": "A stream runs gently through these hills, and the ledges make the way down quicker than the way up." },
    { "key": "route_206", "about": "The Cycling Road: a smooth ribbon of tarmac that riders coast down from end to end." },
    { "key": "route_207", "about": "A rough road cut into the stone at the foot of Mt. Coronet." },
    { "key": "route_208", "about": "Soft meadows spread out under Mt. Coronet's bare cliffs, grass against rock." },
    { "key": "route_209", "about": "A gentle road that crosses its brooks again and again, between thickets and grass." },
    { "key": "route_210_north", "about": "A wild gorge that the fog never leaves." },
    { "key": "route_210_south", "about": "A narrow way between walls of grass tall enough to brush a walker's face." },
    { "key": "route_211", "about": "A mountain track that goes straight through Mt. Coronet, among the highest peaks in Sinnoh." },
    { "key": "route_212_north", "about": "The high wall of a great estate runs along half of this road." },
    { "key": "route_212_south", "about": "Rain falls here without end, and the road picks its way between deep puddles." },
    { "key": "route_213", "about": "A beach sheltered by a line of rocks out in the water, with a resort hotel looking over it." },
    { "key": "route_214", "about": "The road from Veilstone City down to the lake: untamed, say some; untidy, say others." },
    { "key": "route_215", "about": "It pours here day and night. Only Trainers who don't mind a soaking stay." },
    { "key": "route_216", "about": "A road down from Mt. Coronet where the snow never stops and the drifts lie deep." },
    { "key": "route_217", "about": "Wind off Mt. Coronet whips the snow into a blizzard that never lets up. Come ready for it." },
    { "key": "route_218", "about": "A short road, and a favourite of the anglers who know about it." },
    { "key": "route_219", "about": "White sand a few steps from Sandgem Town, with a soft wind off the sea." },
    { "key": "route_220", "about": "Calm water and kind tides for swimmers, with sandbars to rest on along the way." },
    { "key": "route_221", "about": "A straight road between green verges and scattered trees." },
    { "key": "route_222", "about": "A road beside a sandy shore where anglers stand casting all day." },
    { "key": "route_223", "about": "A sea route that threads between rocks and sandbars." },
    { "key": "route_224", "about": "Grass, crags, sea and sand in one place, like a small model of all Sinnoh." },
    { "key": "route_225", "about": "A path that climbs and drops among the crags. It asks a lot of the legs." },
    { "key": "route_226", "about": "A path along the top of sheer cliffs, with the surf breaking right beneath." },
    { "key": "route_227", "about": "A steep, rough mountain trail under a steady fall of volcanic ash." },
    { "key": "route_228", "about": "A harsh path scoured by a sandstorm that the sea wind drives across it." },
    { "key": "route_229", "about": "A shore path through a tangle of trees and undergrowth." },
    { "key": "route_230", "about": "A sea route running west to east, past an island green with plants." },
    { "key": "seabreak_path", "about": "A straight path with the sea on either hand. It ends at Flower Paradise." },
    { "key": "twinleaf_town", "flag": "FLAG_FIRST_ARRIVAL_TWINLEAF_TOWN", "about": "A small town that smells of young leaves. It has the feel of a place where things begin." },
    { "key": "sandgem_town", "flag": "FLAG_FIRST_ARRIVAL_SANDGEM_TOWN", "about": "A town on the sand beside the beach, with salt on the breeze." },
    { "key": "floaroma_town", "flag": "FLAG_FIRST_ARRIVAL_FLOAROMA_TOWN", "about": "A town of gardeners, sweet with the scent of its flowers the year round." },
    { "key": "solaceon_town", "flag": "FLAG_FIRST_ARRIVAL_SOLACEON_TOWN", "about": "Mild weather makes this an unhurried town, easy for people and Pokémon alike." },
    { "key": "celestic_town", "flag": "FLAG_FIRST_ARRIVAL_CELESTIC_TOWN", "about": "A very small town that keeps Sinnoh's history and its old customs." },
    { "key": "survival_area", "flag": "FLAG_FIRST_ARRIVAL_SURVIVAL_AREA", "about": "A town of eager Trainers who come to train hard and sharpen their battling." },
    { "key": "resort_area", "flag": "FLAG_FIRST_ARRIVAL_RESORT_AREA", "about": "A town for Trainers who know that battling isn't the only joy Pokémon bring." },
    { "key": "jubilife_city", "flag": "FLAG_FIRST_ARRIVAL_JUBILIFE_CITY", "about": "The most modern city in Sinnoh, full of people in a hurry." },
    { "key": "canalave_city", "flag": "FLAG_FIRST_ARRIVAL_CANALAVE_CITY", "about": "A harbour city split by a canal, with a flavour of lands across the sea." },
    { "key": "oreburgh_city", "flag": "FLAG_FIRST_ARRIVAL_OREBURGH_CITY", "about": "A lively mining town that lives on the riches under its ground." },
    { "key": "eterna_city", "flag": "FLAG_FIRST_ARRIVAL_ETERNA_CITY", "about": "An old city where traces of a half-forgotten past still show." },
    { "key": "hearthome_city", "flag": "FLAG_FIRST_ARRIVAL_HEARTHOME_CITY", "about": "A warm city that began as a meeting place for people and Pokémon and grew into a market town." },
    { "key": "pastoria_city", "flag": "FLAG_FIRST_ARRIVAL_PASTORIA_CITY", "about": "A city founded to look after the Great Marsh, grown bit by bit ever since." },
    { "key": "veilstone_city", "flag": "FLAG_FIRST_ARRIVAL_VEILSTONE_CITY", "about": "A city hewn out of steep rock. The mountains keep it apart from its neighbours." },
    { "key": "sunyshore_city", "flag": "FLAG_FIRST_ARRIVAL_SUNYSHORE_CITY", "about": "A harbour city round the bay of a cape, crossed overhead by raised walkways." },
    { "key": "snowpoint_city", "flag": "FLAG_FIRST_ARRIVAL_SNOWPOINT_CITY", "about": "A city of deep winter, its sturdy trees and houses under thick snow." },
    { "key": "victory_road", "flag": "FLAG_FIRST_ARRIVAL_OUTSIDE_VICTORY_ROAD", "about": "The end of a long, hard road for every Trainer who means to be the best." },
    { "key": "pokemon_league", "flag": "FLAG_FIRST_ARRIVAL_POKEMON_LEAGUE", "about": "The end of a long, hard road for every Trainer who means to be the best." },
    { "key": "fight_area", "flag": "FLAG_FIRST_ARRIVAL_FIGHT_AREA", "about": "A small port where Trainers gather who would sooner battle than eat." },
    { "key": "verity_lakefront", "about": "One of the lakes that stand for Sinnoh, a land rich in water. A strange old story is told of it." },
    { "key": "valor_lakefront", "about": "One of the lakes that stand for Sinnoh, a land rich in water. A strange old story is told of it." },
    { "key": "acuity_lakefront", "about": "One of the lakes that stand for Sinnoh, a land rich in water. A strange old story is told of it." },
    { "key": "spring_path", "about": "The way to Sinnoh's fourth lake, which was long kept a secret." },
    { "key": "valley_windworks", "about": "A valley crowded with wind turbines round the Valley Windworks." },
    { "key": "eterna_forest", "about": "A forest of cool air, where the close-grown trees make a maze of their own." },
    { "key": "fuego_ironworks", "about": "A sprawling ironworks with the forest at its back." },
    { "key": "mount_coronet", "about": "A sacred mountain, snow-capped in every season, with a great maze of caves inside." },
    { "key": "fullmoon_island", "about": "A shut-in wood round a little pond shaped like a crescent." },
    { "key": "stark_mountain", "about": "A harsh mountain of rock that buries itself in the ash it throws out." },
    { "key": "flower_paradise", "about": "A dot of an island far from anywhere, covered in flowers." },
    { "key": "iron_island", "about": "A small island rich in ore, out in the western sea." },
    { "key": "newmoon_island", "about": "A shut-in wood round a little round pond." },
    { "key": "battle_frontier", "flag": "FLAG_FIRST_ARRIVAL_BATTLE_PARK", "about": "The Battle Frontier, where the very best Trainers come to test themselves." }
  ],
