    { "key": "ravaged_path", "name": "Ravaged Path", "flag": "FLAG_FIRST_ARRIVAL_RAVAGED_PATH", "arrival": [ "ravaged_path" ], "about": "A way cut through a spur of rock: the short road to Floaroma Town." },
