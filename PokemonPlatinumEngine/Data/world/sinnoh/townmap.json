    { "key": "route_210_coffee_shop", "name": "Café Cabin", "flag": "FLAG_FIRST_ARRIVAL_ROUTE_210_COFFEE_SHOP", "about": "A café among the trees. Its pride is Moomoo Milk fresh from the herd." },
    { "key": "pokemon_mansion", "name": "Pokémon Mansion", "flag": "FLAG_FIRST_ARRIVAL_POKEMON_MANSION", "about": "The grand house behind the wall, with its owner's cherished garden at the back." },
    { "key": "route_212_move_tutor", "name": "Move Tutor's House", "flag": "FLAG_FIRST_ARRIVAL_ROUTE_212_MOVE_TUTOR", "about": "The people of this house teach moves in exchange for coloured Shards." },
    { "key": "doctor_footsteps_house", "name": "Dr. Footstep's House", "flag": "FLAG_FIRST_ARRIVAL_DOCTOR_FOOTSTEPS_HOUSE", "about": "A little house on the beach, home of a man who calls himself Dr. Footstep." },
