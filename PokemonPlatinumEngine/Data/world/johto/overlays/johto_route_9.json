      "name": "Sid",
      "trainer": {
        "dialogueBefore": "Camper Sid: I pitched my tent right on the road. Anyone who passes has to battle me!",
        "dialogueAfter": "Camper Sid: I should have pitched it somewhere quieter."
      }
    },
    "r09_picnicgirl_2": {
      "name": "Edna",
      "trainer": {
        "dialogueBefore": "Picnicker Edna: I walk this road every weekend. My Pokémon know every bump in it!",
        "dialogueAfter": "Picnicker Edna: We tripped over the last bump."
      }
    },
    "r09_campboy_2_2": {
      "name": "Dean",
      "trainer": {
        "dialogueBefore": "Camper Dean: I'm on my way to Rock Tunnel. You look like a good warm-up!",
        "dialogueAfter": "Camper Dean: Some warm-up. I'm worn out."
      }
    },
    "r09_mount_2": {
      "name": "Clarke",
      "trainer": {
        "dialogueBefore": "Hiker Clarke: These hills have nothing on the mountains of Johto. Let's see what you've brought!",
        "dialogueAfter": "Hiker Clarke: You'd make a fine climber."
      }
