{
  // The Pokéathlon Dome's square (plan 20 · J13), west of Route 35's gate house: HeartGold's own map of it
  // (MAP_POKEATHLON_DOME), the dome at its head and its lobby behind the three doors. The dome's owner stands by the
  // way in with his Poliwrath, where HeartGold has him greet a first visit (his scene and its flag, FLAG_UNK_225, are
  // left out: he stays to talk). The stall's keeper sells nothing until the dome's shop (plan 15 · E8). The square's song
  // is Route 34's, as HeartGold's is
  "area": "pokeathlon_dome",
  "bgmTrack": "johto/route34",
  "people": {
    "d49_thlonowner": {
      "name": "Dome Owner",
      "still": true,
      "hiddenBy": "",
      "dialog": [
        "Welcome to the Pokéathlon Dome! I built it so that every Pokémon, strong in battle or not, has a place to shine.",
        "The reception is inside. Bring three Pokémon and enter a course!"
      ]
    },
    "d49_tsure_poke_static_poliwrath": {
      "name": "Poliwrath",
      "npcType": "Pokemon",
      "species": "Poliwrath",
      "still": true,
      "hiddenBy": "",
      "dialog": [ "Poliwrath flexed its arms. It looks ready for any event." ]
    },
    "d49_gsboy2": {
      "name": "Boy",
      "still": true,
      "dialog": [
        "My Oddish isn't fast and isn't strong, but it can jump! Every Pokémon is good at something here."
