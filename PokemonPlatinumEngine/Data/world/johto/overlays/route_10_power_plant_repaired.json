    "r10r0201_policeman": {
      "name": "Policeman",
      "still": true,
      "dialog": [
        "I'm posted here to keep the plant safe. Nobody touches that generator on my watch."
      ]
    },
    "r10r0201_policeman_2": {
      "name": "Policeman",
      "still": true,
      "dialog": [
        "All quiet at the back of the plant. Just the hum of the machines."
      ]
    },
    "r10r0201_gsassistantm": {
      "name": "Engineer",
      "still": true,
      "dialog": [
        "The generator spins day and night. If it ever stopped, the Magnet Train would stop with it."
