  "people": {
    "d37r0104_rocketm": {
      "name": "Grunt",
      "trainer": {
        "dialogueBefore": "Grunt: A kid, down here? Somebody's let you wander a long way from home.",
        "dialogueAfter": "Grunt: Fine, go on, get lost in the shutters for all I care."
      }
    },
    "d37r0104_rocketm_2": {
      "name": "Grunt",
      "trainer": {
        "dialogueBefore": "Grunt: These passages are ours now. Turn round!",
        "dialogueAfter": "Grunt: Ours... for about another minute, it seems."
      }
    },
    "d37r0104_rocketm_3": {
      "name": "Grunt",
      "trainer": {
        "dialogueBefore": "Grunt: The switches? Don't you dare touch them!",
        "dialogueAfter": "Grunt: Go on, then. See if you can make sense of them."
      }
    },
    "d37r0104_rocketw": {
      "name": "Grunt",
      "trainer": {
        "dialogueBefore": "Grunt: Nobody goes near the warehouse. Boss's orders!",
        "dialogueAfter": "Grunt: The boss isn't going to like this one bit."
      }
    },
    "d37r0104_thief": {
      "name": "Orson",
      "trainer": {
        "dialogueBefore": "Burglar Orson: With Team Rocket keeping everyone busy, a fellow can pick up all sorts down here.",
        "dialogueAfter": "Burglar Orson: I'll find something else to pick up. Not a fight, though."
      }
    },
    "d37r0104_thief_2": {
      "name": "Duncan",
      "trainer": {
        "dialogueBefore": "Burglar Duncan: Hand over your money and nobody needs to battle!",
        "dialogueAfter": "Burglar Duncan: I should have just stuck to the shops."
      }
    }
  },
