    { "name": "Violet_TradeHouse", "matrix": 95, "area": "violet_bellsprout_onyx_trade_house", "trees": "Round", "setting": "Indoors" },
    { "name": "Violet_Route36Gate", "matrix": 70, "area": "violet_route_36_gatehouse", "trees": "Round", "setting": "Indoors" }
