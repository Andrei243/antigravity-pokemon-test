{
  // What is built of Johto so far (plan 20). The maps are HeartGold's, read by tools/MapImporter's second DS reader
  // (plan 20 · J1: --game heartgold); "maps" are the maps the game makes from its matrices, "areas" the areas open
  // to walk in. After adding an area, run `dotnet run --project tools/MapImporter -- --game heartgold --data` and
  // write its overlay (overlays/<key>.json). Johto's keys are HeartGold's map constants without MAP_, lower case
  // (new_bark, route_29, violet). A room is a matrix of its own ("Indoors"), several rooms sharing one: each has a
  // map of its own, told apart by its area.
  "region": "Johto",
  "maps": [
    // The overworld: HeartGold's EVERYWHERE, Johto and Kanto on one grid of 47 by 17 chunks
    { "name": "Johto", "matrix": 0, "trees": "Round" },
    // Plan 20 · J2: New Bark Town's rooms
    { "name": "NewBark_PlayersHouse_1F", "matrix": 71, "area": "new_bark_player_house_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_PlayersHouse_2F", "matrix": 72, "area": "new_bark_player_house_2f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_RivalsHouse_1F", "matrix": 71, "area": "new_bark_rival_house_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_RivalsHouse_2F", "matrix": 72, "area": "new_bark_rival_house_2f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_ElmsLab", "matrix": 100, "area": "new_bark_elms_lab_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_ElmsHouse", "matrix": 101, "area": "new_bark_elms_lab_2f", "trees": "Round", "setting": "Indoors" },
    { "name": "NewBark_SouthwestHouse", "matrix": 66, "area": "new_bark_southwest_house", "trees": "Round", "setting": "Indoors" },
    // Route 29's gate house to Route 46, and Cherrygrove City's rooms
    { "name": "Route29_Route46Gate", "matrix": 69, "area": "route_29_route_46_gatehouse", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_PokemonCenter_1F", "matrix": 73, "area": "cherrygrove_pokecenter_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_PokemonCenter_B1F", "matrix": 77, "area": "cherrygrove_pokecenter_b1f", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_Mart", "matrix": 104, "area": "cherrygrove_pokemart", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_GuideGentsHouse", "matrix": 96, "area": "cherrygrove_guide_gent_house", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_SouthwestHouse", "matrix": 97, "area": "cherrygrove_southwest_house", "trees": "Round", "setting": "Indoors" },
    { "name": "Cherrygrove_SoutheastHouse", "matrix": 97, "area": "cherrygrove_southeast_house", "trees": "Round", "setting": "Indoors" },
    // Routes 30 and 31: the Apricorn man's house, Mr. Pokémon's, and the gate house to Violet City
    { "name": "Route30_ApricornHouse", "matrix": 66, "area": "route_30_apricorn_house", "trees": "Round", "setting": "Indoors" },
    { "name": "Route30_MrPokemonsHouse", "matrix": 103, "area": "route_30_mr_pokemon_house", "trees": "Round", "setting": "Indoors" },
    { "name": "Route31_VioletGate", "matrix": 70, "area": "route_31_violet_gatehouse", "trees": "Round", "setting": "Indoors" },
    // Violet City's rooms (its Gym and Sprout Tower open with plan 20 · J4 and J5)
    { "name": "Violet_PokemonCenter_1F", "matrix": 73, "area": "violet_pokecenter_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "Violet_PokemonCenter_B1F", "matrix": 77, "area": "violet_pokecenter_b1f", "trees": "Round", "setting": "Indoors" },
