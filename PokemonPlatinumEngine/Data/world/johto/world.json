    "violet", "violet_pokecenter_1f", "violet_pokecenter_b1f", "violet_pokemart", "violet_pokemon_school",
    "violet_northwest_house", "violet_bellsprout_onyx_trade_house", "violet_route_36_gatehouse"
  ]
