    "expert_m": { "name": "Old Man", "dialog": [ "The sea doesn't age, you know. Sixty years I've looked at it, and it's as young as the day I first saw it." ] },
    "expert_f": { "name": "Old Woman", "dialog": [ "My husband asked me to marry him right here, sixty years ago. We still come to watch the waves together." ] },
