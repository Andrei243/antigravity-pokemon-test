  "signs": {
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart1": "The dots tell of a people. In this cave we lived,\nand the cave gave us everything we had.",
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart2": "The dots go on. All we owned we owed to the\nPokémon, who shared the land with us.",
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart3": "The dots grow stern. But we sealed the Pokémon\naway, and shut them in the dark.",
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart4": "The dots are crowded here. We feared their\npower, and we feared what it might do.",
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart5": "The dots are steadier again. Those who come\nwith courage and with hope, let them go on.",
    "SealedChamber_InnerRoom_EventScript_BrailleStoryPart6": "The last dots: open the door, and an eternal\nPokémon waits behind it."
  }
