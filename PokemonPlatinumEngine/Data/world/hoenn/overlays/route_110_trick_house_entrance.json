{
  // The Trick House on Route 110 (plan 21 · H3, part b; its later puzzles plan 21 · H12, part j): the Trick Master hides
  // somewhere in his front room, a place of his own for each puzzle, and has to be found before the puzzle opens behind
  // the scroll on the back wall (route_110_trick_house_entrance.txt). Each puzzle after the first waits for a Badge, as
  // Emerald's do, and the last for the Hall of Fame
  "area": "route_110_trick_house_entrance",
  "bgmTrack": "hoenn/trick_house",
  // The way into the puzzle behind the scroll, open from his finding to the puzzle's end (FLAG_HOENN_TRICK_HOUSE_OPEN)
  "switches": [ { "warp": 2, "from": "FLAG_HOENN_TRICK_HOUSE_OPEN" } ],
  "triggers": [
    { "trigger": 0, "script": "BeingWatched" },
    { "trigger": 1, "script": "BeingWatched" },
    { "trigger": 2, "script": "BeingWatched" },
    { "trigger": 3, "script": "BeingWatched" },
    // The way behind the scroll leads to the puzzle the Trick Master has built by now: the first by the warp itself,
    // the later ones by these, which go before the warp on its own tile (Emerald's entrance warps to the puzzle room
    // VAR_TRICK_HOUSE_LEVEL names)
    { "x": 5, "z": 2, "script": "IntoPuzzle2", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 1 },
    { "x": 5, "z": 2, "script": "IntoPuzzle3", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 2 },
    { "x": 5, "z": 2, "script": "IntoPuzzle4", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 3 },
    { "x": 5, "z": 2, "script": "IntoPuzzle5", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 4 },
    { "x": 5, "z": 2, "script": "IntoPuzzle6", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 5 },
    { "x": 5, "z": 2, "script": "IntoPuzzle7", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 6 },
    { "x": 5, "z": 2, "script": "IntoPuzzle8", "variable": "VAR_TRICK_HOUSE_LEVEL", "value": 7 }
  ],
  // Where he hides, a place for each puzzle (Emerald's SetHidingSpotPuzzle1 to 8): under the desk, behind the potted
  // tree, in the dresser, outside the window, in the planter, in the cupboard, behind the other window, under the cushion
  "readAt": [
    { "x": 6, "z": 3, "script": "Desk" }, { "x": 6, "z": 4, "script": "Desk" },
    { "x": 11, "z": 5, "script": "Tree" },
    { "x": 9, "z": 1, "script": "Dresser" },
    { "x": 3, "z": 1, "script": "Window" },
    { "x": 0, "z": 5, "script": "Planter" },
    { "x": 11, "z": 1, "script": "Cupboard" },
    { "x": 8, "z": 1, "script": "BackWindow" },
    { "x": 4, "z": 4, "script": "Cushion" }
  ],
  "read": { "Route110_TrickHouseEntrance_EventScript_Door": "Door" },
  "people": {
    "trick_master": { "name": "Trick Master", "npcType": "trick_master", "script": "TrickMaster", "still": true }
  }
}
