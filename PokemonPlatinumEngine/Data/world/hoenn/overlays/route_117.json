    "running_triathlete_m": { "name": "Dylan", "script": "Dylan", "trainer": { "dialogueBefore": "Triathlete Dylan: Running's my thing. And when I run, I run into trainers!", "dialogueAfter": "Triathlete Dylan: I'll go for a jog to clear my head." } },
    "woman_2": { "name": "Lydia", "script": "Lydia", "trainer": { "dialogueBefore": "Pokémon Breeder Lydia: Look at all the Pokémon I've raised! Six of them, all so lovely.", "dialogueAfter": "Pokémon Breeder Lydia: My dears, you did your best." } },
    "man_4": { "name": "Isaac", "script": "Isaac", "trainer": { "dialogueBefore": "Pokémon Breeder Isaac: I raise my Pokémon with love. Battling with them is the best part!", "dialogueAfter": "Pokémon Breeder Isaac: More love next time. And more training." } },
    "running_triathlete_f": { "name": "Maria", "script": "Maria", "trainer": { "dialogueBefore": "Triathlete Maria: My Doduo and I run every day! Keep up if you can!", "dialogueAfter": "Triathlete Maria: You ran rings round us." } },
    "maniac": { "name": "Derek", "trainer": { "dialogueBefore": "Bug Maniac Derek: The bugs here are wonderful! Want to see my favourites?", "dialogueAfter": "Bug Maniac Derek: They're still wonderful, even when they lose." } },
    "lass": { "name": "Anna & Meg", "trainer": { "dialogueBefore": "Sr. & Jr. Anna & Meg: Big sister and little sister! We battle as a team!", "dialogueAfter": "Sr. & Jr. Anna & Meg: Even together, we couldn't do it." } },
    "lass_2": { "name": "Anna & Meg", "trainer": { "dialogueBefore": "Sr. & Jr. Anna & Meg: Sister's with me, so I'm not scared at all!", "dialogueAfter": "Sr. & Jr. Anna & Meg: We'll get stronger together!" } },
    "lass_3": { "name": "Brandi", "trainer": { "dialogueBefore": "Psychic Brandi: I can sense it. You're going to battle me. Am I right?", "dialogueAfter": "Psychic Brandi: I didn't sense that coming." } },
    "girl_3": { "name": "Aisha", "trainer": { "dialogueBefore": "Battle Girl Aisha: I'm training on the open road! You'll be my sparring partner.", "dialogueAfter": "Battle Girl Aisha: Back to training, then." } },
    "running_triathlete_f_2": { "name": "Melina", "trainer": { "dialogueBefore": "Triathlete Melina: Ready, set... battle!", "dialogueAfter": "Triathlete Melina: I need to warm up more." } }
