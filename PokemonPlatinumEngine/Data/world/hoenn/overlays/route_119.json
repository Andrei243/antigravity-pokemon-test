    "bug_catcher": { "name": "Greg", "trainer": { "dialogueBefore": "Bug Catcher Greg: The tall grass here is full of bugs! Let me show you my best ones!", "dialogueAfter": "Bug Catcher Greg: Back into the grass to find more." } },
    "maniac": { "name": "Taylor", "trainer": { "dialogueBefore": "Bug Maniac Taylor: I've raised these bugs from tiny Wurmple! Witness their glory!", "dialogueAfter": "Bug Maniac Taylor: Their glory has been dimmed." } },
    "maniac_2": { "name": "Donald", "trainer": { "dialogueBefore": "Bug Maniac Donald: Rain brings out the best bugs. And the best bug battles!", "dialogueAfter": "Bug Maniac Donald: Washed out by the rain." } },
    "camper": { "name": "Jackson", "script": "Jackson", "trainer": { "dialogueBefore": "Pkmn Ranger Jackson: I patrol this route rain or shine. Show me you can handle yourself out here!", "dialogueAfter": "Pkmn Ranger Jackson: You'll be fine out here." } },
    "maniac_3": { "name": "Brent", "trainer": { "dialogueBefore": "Bug Maniac Brent: Surskit skates on the puddles here. Have you ever seen anything so lovely?", "dialogueAfter": "Bug Maniac Brent: It slipped on its own puddle." } },
    "picnicker": { "name": "Catherine", "script": "Catherine", "trainer": { "dialogueBefore": "Pkmn Ranger Catherine: I keep an eye on the Pokémon here. Let me see how you treat yours!", "dialogueAfter": "Pkmn Ranger Catherine: Your Pokémon trust you. I can tell." } },
    "bug_catcher_2": { "name": "Doug", "trainer": { "dialogueBefore": "Bug Catcher Doug: My Shinobuzz is so fast you won't even see it coming!", "dialogueAfter": "Bug Catcher Doug: You saw it coming after all." } },
    "bug_catcher_3": { "name": "Kent", "trainer": { "dialogueBefore": "Bug Catcher Kent: Bzzz! That's the sound of my Shinobuzz about to win!", "dialogueAfter": "Bug Catcher Kent: Bzzz... that's the sound of me losing." } },
    "ninja_boy": { "name": "Yasu", "trainer": { "dialogueBefore": "Ninja Boy Yasu: You walked right past me! My hiding skills are flawless!", "dialogueAfter": "Ninja Boy Yasu: My battle skills are less flawless." } },
    "ninja_boy_2": { "name": "Takashi", "trainer": { "dialogueBefore": "Ninja Boy Takashi: Hah! I was hiding in the grass the whole time!", "dialogueAfter": "Ninja Boy Takashi: Back into hiding, in shame." } },
    "ninja_boy_3": { "name": "Hideo", "trainer": { "dialogueBefore": "Ninja Boy Hideo: Shh! I'm practising my stealth! Now you've seen me, so we battle!", "dialogueAfter": "Ninja Boy Hideo: More practice needed." } },
    "man_5": { "name": "Hugh", "trainer": { "dialogueBefore": "Bird Keeper Hugh: My birds love the wind over the river. Let's see if they carry the day!", "dialogueAfter": "Bird Keeper Hugh: They didn't carry it far." } },
    "man_5_2": { "name": "Phil", "trainer": { "dialogueBefore": "Bird Keeper Phil: Swiftarrow, dive! This trainer's wide open!", "dialogueAfter": "Bird Keeper Phil: Not so wide open after all." } },
    "fisherman": { "name": "Chris", "trainer": { "dialogueBefore": "Fisherman Chris: I've fished every pool on this route. Look what I've caught!", "dialogueAfter": "Fisherman Chris: Maybe I should throw a few back." } },
    "woman_2": { "name": "Rachel", "trainer": { "dialogueBefore": "Parasol Lady Rachel: My parasol keeps the rain off. Can you keep my Pokémon off?", "dialogueAfter": "Parasol Lady Rachel: You certainly could." } },
    "man_5_3": { "name": "Dayton", "trainer": { "dialogueBefore": "Kindler Dayton: All this rain can't put out my fire! Come on!", "dialogueAfter": "Kindler Dayton: Okay, maybe it can." } },
    "man_5_4": { "name": "Fabian", "trainer": { "dialogueBefore": "Guitarist Fabian: The rain on the leaves sounds like a drum. Let's battle to it!", "dialogueAfter": "Guitarist Fabian: Lost the beat." } }
