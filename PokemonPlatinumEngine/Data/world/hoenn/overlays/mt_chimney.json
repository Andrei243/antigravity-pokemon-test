    "expert_f": { "name": "Shelby", "trainer": { "dialogueBefore": "Expert Shelby: I've soaked in these hot springs for years and battled on this mountain for longer. Shall we?", "dialogueAfter": "Expert Shelby: My, my. You battle like the mountain itself." } },
    "beauty": { "name": "Melissa", "trainer": { "dialogueBefore": "Beauty Melissa: The volcano's heat is wonderful for the skin. Now, let me warm you up with a battle!", "dialogueAfter": "Beauty Melissa: Oh, I'm the one who's flushed now." } },
    "beauty_2": { "name": "Sheila", "trainer": { "dialogueBefore": "Beauty Sheila: I climbed all this way for the view, and now I've found you. Let's battle!", "dialogueAfter": "Beauty Sheila: The view's still lovely, at least." } },
    "beauty_3": { "name": "Shirley", "trainer": { "dialogueBefore": "Beauty Shirley: A volcano, a hot spring and a battle. What a perfect day out!", "dialogueAfter": "Beauty Shirley: Well, two out of three isn't bad." } },
