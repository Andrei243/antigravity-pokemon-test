    "mt_chimney_tabitha": { "name": "Tabitha", "npcType": "tabitha", "still": true, "trainer": { "dialogueBefore": "Tabitha: Hehehe! You've come a long way up the mountain just to be turned back. The boss isn't to be disturbed!", "dialogueAfter": "Tabitha: Hehe... I lost? Well, the boss will deal with you himself." } },
    "mt_chimney_magma_grunt_1": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "trainer": { "dialogueBefore": "Team Magma Grunt: The volcano's about to get a whole lot livelier. Nobody spoils the boss's plan!", "dialogueAfter": "Team Magma Grunt: Ugh, that's not how it was supposed to go." } },
    "mt_chimney_magma_grunt_2": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "trainer": { "dialogueBefore": "Team Magma Grunt: Can you feel the heat? That's Team Magma's dream about to come true!", "dialogueAfter": "Team Magma Grunt: I'm the one who got burned..." } },
    "magma_member_m": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Team Aqua, here? You lot never know when to quit!" ] },
    "magma_member_m_2": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Stay back! This is between Team Magma and Team Aqua!" ] },
    "magma_member_m_3": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Nobody gets to the boss! Not Team Aqua, and not you!" ] },
    "magma_member_m_4": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Keep at it, Poochyena! Show those Aqua fools who rules the mountain!" ] },
    "magma_member_m_5": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Hey, we're a bit busy here! Can't you see we're in the middle of something?" ] },
    "magma_member_m_6": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "still": true, "dialog": [ "Grr! Team Aqua's like ants at a picnic. Always where they're not wanted!" ] },
    "aqua_member_m": { "name": "Team Aqua Grunt", "npcType": "aqua_grunt", "still": true, "dialog": [ "Team Magma won't get their volcano without a fight from us!" ] },
    "aqua_member_m_2": { "name": "Team Aqua Grunt", "npcType": "aqua_grunt", "still": true, "dialog": [ "Hold the line! Don't let Team Magma near the boss!" ] },
    "aqua_member_m_3": { "name": "Team Aqua Grunt", "npcType": "aqua_grunt", "still": true, "dialog": [ "If that volcano blows, the whole sea's in trouble! We can't let it happen!" ] },
