      "name": "Calvin",
      "trainer": {
        "dialogueBefore": "Youngster Calvin: You looked at me! That means we battle. Those are the rules!",
        "dialogueAfter": "Youngster Calvin: Hmm. Maybe the rules need changing."
      }
    },
    "bug_catcher": {
      "name": "Rick",
      "trainer": {
        "dialogueBefore": "Bug Catcher Rick: Stop right there! My bugs have been itching for a battle.",
        "dialogueAfter": "Bug Catcher Rick: My bugs are buzzing with disappointment."
      }
    },
    "lass": {
      "name": "Tiana",
      "trainer": {
        "dialogueBefore": "Lass Tiana: I'm still learning, but I'm learning fast! Let's battle!",
        "dialogueAfter": "Lass Tiana: That's one more thing learned, then."
      }
    },
    "youngster_2": {
      "name": "Allen",
      "trainer": {
        "dialogueBefore": "Youngster Allen: You're new around here, aren't you? Let me show you how it's done!",
        "dialogueAfter": "Youngster Allen: Well, you've shown me how it's done instead."
      }
    }
  },
  "signs": {
    "Route102_EventScript_RouteSignPetalburg": "Route 102\nPetalburg City ahead",
    "Route102_EventScript_RouteSignOldale": "Route 102\nOldale Town ahead"
