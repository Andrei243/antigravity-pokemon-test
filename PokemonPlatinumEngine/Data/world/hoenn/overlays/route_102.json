{
  // Route 102 (plan 21 · H1), west from Oldale Town to Petalburg City. Its trainers are Emerald's own, their teams read
  // from Hoenn's trainers.json by the trainer each object's script names; the berry trees wait for Hoenn's berries
  "area": "route_102",
  "bgmTrack": "hoenn/route101",
  "trees": "Round",
  "people": {
    "little_boy": {
      "name": "Little Boy",
      "dialog": [ "I saw a Pokémon with a big leaf on its head! It ran off into the grass when I said hello." ]
    },
    "boy_1": {
      "name": "Boy",
      "dialog": [
        "Petalburg City is just ahead. The Gym there is run by a really strong trainer.",
        "Nobody gets to challenge him until they've proved themselves somewhere else first."
      ]
