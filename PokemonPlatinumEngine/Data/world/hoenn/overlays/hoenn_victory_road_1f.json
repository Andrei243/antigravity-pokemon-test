    "man_3": { "name": "Edgar", "trainer": { "dialogueBefore": "Cooltrainer Edgar: Everyone who reaches Victory Road has eight Badges. So we're equals. Let's see who's more equal!", "dialogueAfter": "Cooltrainer Edgar: All right, you're the more equal one." } },
    "woman_5": { "name": "Hope", "trainer": { "dialogueBefore": "Cooltrainer Hope: This cave is where dreams of the League are made, or broken. Which will yours be?", "dialogueAfter": "Cooltrainer Hope: Mine were the ones that broke." } },
    "man_3_2": { "name": "Albert", "trainer": { "dialogueBefore": "Cooltrainer Albert: I've walked this road a hundred times and never reached the end. Maybe you'll be my hundred-and-first try!", "dialogueAfter": "Cooltrainer Albert: Back to the start for me." } },
    "woman_5_2": { "name": "Katelynn", "trainer": { "dialogueBefore": "Cooltrainer Katelynn: Only the strongest leave this cave at the top. Prove you're one of them!", "dialogueAfter": "Cooltrainer Katelynn: You've proved it to me, at least." } },
    "man_3_3": { "name": "Quincy", "trainer": { "dialogueBefore": "Cooltrainer Quincy: My team and I have trained our whole lives for the League. You won't stop us here!", "dialogueAfter": "Cooltrainer Quincy: We'll train a little longer, then." } }
  }
