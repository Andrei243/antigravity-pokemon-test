  "people": {
    "magma_hideout_4f_grunt_1": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "trainer": { "dialogueBefore": "Team Magma Grunt: Everyone gets to see Groudon but me! Not even the tip of its tail... Oh no, I said Groudon out loud!", "dialogueAfter": "Team Magma Grunt: Does Groudon even have a tail, I wonder?" } },
    "magma_hideout_4f_grunt_2": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "trainer": { "dialogueBefore": "Team Magma Grunt: Fuhahaha! Any moment now, Team Magma's great goal will be reached!", "dialogueAfter": "Team Magma Grunt: Boss! Boss! Somebody's coming your way!" } },
    "magma_hideout_4f_grunt_3": { "name": "Team Magma Grunt", "npcType": "magma_grunt", "trainer": { "dialogueBefore": "Team Magma Grunt: You're not finished yet! I'm not letting you past that easily!", "dialogueAfter": "Team Magma Grunt: Come on, one more go..." } },
    "magma_hideout_4f_tabitha": { "name": "Tabitha", "npcType": "tabitha", "trainer": { "dialogueBefore": "Tabitha: Hehehe! Come all this way, have you? Then I'll let you in on it. Groudon sleeps right up ahead, and the boss has just gone to wake it!", "dialogueAfter": "Tabitha: Hehe... And while you were busy with me, the boss will have woken Groudon." } },
