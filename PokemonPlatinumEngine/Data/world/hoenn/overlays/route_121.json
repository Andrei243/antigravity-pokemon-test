  "people": {
    "woman_3": { "name": "Woman", "dialog": [ "That peak beyond the water is Mt. Pyre. People climb it to remember the Pokémon they have lost." ] },
    "route121_grunt_1": { "name": "Team Aqua Grunt", "dialog": [ "Mt. Pyre is just across the water. Let's get going!" ], "still": true },
    "route121_grunt_2": { "name": "Team Aqua Grunt", "dialog": [ "Don't get in our way, kid. We've got business on the mountain." ], "still": true },
    "route121_grunt_3": { "name": "Team Aqua Grunt", "dialog": [ "Whatever's up on that mountain, the boss wants it before Team Magma gets there." ], "still": true },
    "lass": { "name": "Kate & Joy", "trainer": { "dialogueBefore": "Sr. and Jr. Kate & Joy: Mother and daughter, side by side! We'll take you on together!", "dialogueAfter": "Sr. and Jr. Kate & Joy: We'll keep practising, the two of us." } },
    "lass_2": { "name": "Kate & Joy", "trainer": { "dialogueBefore": "Sr. and Jr. Kate & Joy: Mother and daughter, side by side! We'll take you on together!", "dialogueAfter": "Sr. and Jr. Kate & Joy: We'll keep practising, the two of us." } },
    "pokefan_f": { "name": "Vanessa", "trainer": { "dialogueBefore": "Pokéfan Vanessa: Isn't my Pikachu the sweetest? It's tough, too. Watch!", "dialogueAfter": "Pokéfan Vanessa: Still the sweetest, even when it loses." } },
    "gentleman": { "name": "Walter", "script": "Walter", "trainer": { "dialogueBefore": "Gentleman Walter: A stroll with my Manectric, and now a battle. A fine afternoon.", "dialogueAfter": "Gentleman Walter: A fine afternoon, all the same." } },
    "hex_maniac": { "name": "Tammy", "trainer": { "dialogueBefore": "Hex Maniac Tammy: The mountain calls to my Pokémon... and they answer by battling you!", "dialogueAfter": "Hex Maniac Tammy: The mountain has gone quiet." } },
    "beauty": { "name": "Jessica", "script": "Jessica", "trainer": { "dialogueBefore": "Beauty Jessica: My Pokémon are as lovely as they are sly. Can you even see them coming?", "dialogueAfter": "Beauty Jessica: You saw right through us." } },
    "maniac": { "name": "Cale", "trainer": { "dialogueBefore": "Bug Maniac Cale: My moths came out of the Safari Zone's grass. They're the pride of my collection!", "dialogueAfter": "Bug Maniac Cale: Back to the grass to find more." } },
    "man_4": { "name": "Myles", "trainer": { "dialogueBefore": "Pkmn Breeder Myles: I raised all six of these myself. Let's see what you think of them!", "dialogueAfter": "Pkmn Breeder Myles: They're still my pride and joy." } },
    "woman_2": { "name": "Pat", "trainer": { "dialogueBefore": "Pkmn Breeder Pat: Six little ones, all raised with love. Be gentle with them!", "dialogueAfter": "Pkmn Breeder Pat: You weren't gentle at all!" } },
    "man_3": { "name": "Marcel", "trainer": { "dialogueBefore": "Cooltrainer Marcel: I'm on my way to Lilycove to test myself. You'll do for a warm-up.", "dialogueAfter": "Cooltrainer Marcel: Some warm-up. I'm the one who got burned." } },
    "woman_5": { "name": "Cristin", "script": "Cristin", "trainer": { "dialogueBefore": "Cooltrainer Cristin: You look like you've come a long way. Let's see if it shows.", "dialogueAfter": "Cooltrainer Cristin: It shows. It really shows." } }
  },
  "signs": {
    "Route121_EventScript_MtPyrePierSign": "Mt. Pyre Pier\nThe mountain's landing lies across the water to the south.",
    "Route121_EventScript_SafariZoneSign": "Safari Zone\nRare Pokémon from far and wide. Gate just ahead!"
  }
