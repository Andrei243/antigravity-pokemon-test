    { "trigger": 2, "script": "BlueSwitch" },
    { "trigger": 3, "script": "GreenSwitch" },
    { "trigger": 4, "script": "PurpleSwitch" },
    { "trigger": 5, "script": "PurpleSwitch" },
    { "trigger": 6, "script": "RedSwitch" },
