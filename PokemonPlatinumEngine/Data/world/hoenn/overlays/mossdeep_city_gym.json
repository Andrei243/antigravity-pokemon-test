  "people": {
    "tate": { "name": "Tate", "npcType": "tate", "script": "TateAndLiza", "still": true },
    "liza": { "name": "Liza", "npcType": "liza", "script": "TateAndLiza", "still": true },
    "man_2": { "name": "Gym Guide", "script": "GymGuide", "still": true },
    "psychic_m": { "name": "Preston", "trainer": { "dialogueBefore": "Psychic Preston: A battle is won by the stronger will. A wavering mind never wins!", "dialogueAfter": "Psychic Preston: My will wavered. Back to training it." } },
    "psychic_m_2": { "name": "Blake", "trainer": { "dialogueBefore": "Psychic Blake: Watch me lift a Poké Ball with my mind alone! Hnnngh... Hm. It's a bad day.", "dialogueAfter": "Psychic Blake: My battling's having a bad day too." } },
    "lass": { "name": "Maura", "trainer": { "dialogueBefore": "Psychic Maura: The arrows under your feet will turn you round. And so will I!", "dialogueAfter": "Psychic Maura: You found your way after all." } },
    "lass_2": { "name": "Samantha", "trainer": { "dialogueBefore": "Psychic Samantha: I already know how this battle ends. Shall I show you?", "dialogueAfter": "Psychic Samantha: Funny. It ended differently in my head." } },
    "psychic_m_3": { "name": "Virgil", "trainer": { "dialogueBefore": "Psychic Virgil: Show me what talent you have, challenger!", "dialogueAfter": "Psychic Virgil: Talent to spare. Remarkable." } },
    "lass_3": { "name": "Hannah", "trainer": { "dialogueBefore": "Psychic Hannah: Don't feel bad when you lose. It isn't that you're weak. I'm just strong!", "dialogueAfter": "Psychic Hannah: It's me who feels bad now." } },
    "gentleman": { "name": "Nate", "trainer": { "dialogueBefore": "Gentleman Nate: Ho ho. The twins send their students to meet their guests. I am one.", "dialogueAfter": "Gentleman Nate: Ho ho. You may go on." } },
    "hex_maniac": { "name": "Sylvia", "trainer": { "dialogueBefore": "Hex Maniac Sylvia: The statues watch you go round and round... and so do I...", "dialogueAfter": "Hex Maniac Sylvia: The statues saw that. How embarrassing." } },
    "gentleman_2": { "name": "Clifford", "trainer": { "dialogueBefore": "Gentleman Clifford: I have studied the mind for forty years. Let us see what yours can do.", "dialogueAfter": "Gentleman Clifford: Forty years, and still a student." } },
    "lass_4": { "name": "Macey", "trainer": { "dialogueBefore": "Psychic Macey: Tate and Liza never lose in practice. Can you beat their pupil first?", "dialogueAfter": "Psychic Macey: I'll have to practise harder." } },
    "hex_maniac_2": { "name": "Kathleen", "trainer": { "dialogueBefore": "Hex Maniac Kathleen: I saw you coming in my dreams last night. You were very small...", "dialogueAfter": "Hex Maniac Kathleen: Dreams aren't always right, it seems." } },
    "psychic_m_4": { "name": "Nicholas", "trainer": { "dialogueBefore": "Psychic Nicholas: The twins are close now. Close enough to feel their minds. Can you?", "dialogueAfter": "Psychic Nicholas: Go on. They're expecting you." } },
