  // a long gallery, with the ghosts of the north and four Trainers who stayed. It plays Santalune Forest's song until
  // plan 31 writes it a cave song of its own
  "area": "lost_hotel",
  "bgmTrack": "kalos/santalune_forest",
  "trees": "Round",
  "people": {
    "lucien": {
      "name": "Lucien",
      "npcType": "psychic",
      "trainer": {
        "dialogueBefore": "Psychic Lucien: The lobby is full of guests who checked out long ago. They like company. So do I!",
        "dialogueAfter": "Psychic Lucien: The guests say you may stay. They say it very politely."
      }
    },
    "pomme": {
      "name": "Pomme",
      "npcType": "lass",
      "trainer": {
        "dialogueBefore": "Lass Pomme: Did you hear it? The little knock behind the wall? That was me, and now I am coming out!",
        "dialogueAfter": "Lass Pomme: You were not even scared. I am a little scared of you."
      }
    },
    "ambrose": {
      "name": "Ambrose",
      "npcType": "veteran",
      "trainer": {
        "dialogueBefore": "Veteran Ambrose: I was the doorman here when the hotel was grand. Old habits. Let me see your credentials, young Trainer.",
        "dialogueAfter": "Veteran Ambrose: Credentials accepted. Mind the gallery stairs; they have opinions."
      }
    },
    "odile": {
      "name": "Odile",
      "npcType": "psychic",
      "trainer": {
        "dialogueBefore": "Psychic Odile: The gallery is the best room in the hotel. It still has the best view, too, if you are a ghost.",
        "dialogueAfter": "Psychic Odile: A view is better with a friend. I will remember that."
      }
    }
  }
