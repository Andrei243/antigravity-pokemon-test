{
  // What is built of Kalos so far (plan 23 · Z1). X and Y have no decompilation and no dump, so Kalos is drawn by hand on
  // the four-direction tile grid (the user's decision of 2026-11-02): the drawings are tools/MapDraw/kalos, and
  // `dotnet run --project tools/MapDraw -- kalos` writes the chunks, the matrix and the habitats here from them. The area
  // files, the overlays and this index are written by hand. The rooms are hand-made map files (Data/maps), reached by the
  // overlays' doors. Kalos's keys are the places' names in lower case, a route's taking the region's name, since Kanto's
  // routes have the same numbers (kalos_route_1).
  "region": "Kalos",
  // The houses are drawn into the tiles, each found at its door (WorldMapBuilder.BuildingsAtDoors), as a GBA region's are
  "buildingsAtDoors": true,
  "maps": [
    // The overworld: 24 chunks by 24, Vaniville Town in its south-west
    { "name": "Kalos", "matrix": 0, "trees": "Round" },
    // Plan 23 · Z3, second part: the two caves, maps of their own (tools/MapDraw's layout.json "maps")
    { "name": "ReflectionCave", "matrix": 1, "area": "reflection_cave", "trees": "Round", "setting": "Cave" },
    { "name": "GlitteringCave", "matrix": 2, "area": "glittering_cave", "trees": "Round", "setting": "Cave" },
    // Plan 23 · Z4: Victory Road, between Route 21 and the Pokémon League
    { "name": "KalosVictoryRoad", "matrix": 3, "area": "kalos_victory_road", "trees": "Round", "setting": "Cave" }
  ],
  "areas": [
    "vaniville_town",
    "kalos_route_1",
    "aquacorde_town",
    "kalos_route_2",
    "santalune_forest",
    "kalos_route_3",
    "santalune_city",
    "kalos_route_4",
    "lumiose_city",
    // Plan 23 · Z2, second part: west of Lumiose to Camphrier, its two roads, the coast and Cyllage City
    "kalos_route_5",
    "camphrier_town",
    "kalos_route_6",
    "kalos_route_7",
    "kalos_route_8",
    "cyllage_city",
    // Plan 23 · Z3, first part: north from Cyllage by Route 10 to Geosenge Town, and Route 11 to Shalour City
    "kalos_route_10",
    "geosenge_town",
    "kalos_route_11",
    "shalour_city",
    // Plan 23 · Z3, second part: Route 8 on south to Ambrette Town, Route 9 east along the coast, and the two caves
    "ambrette_town",
    "kalos_route_9",
    "reflection_cave",
    "glittering_cave",
    // Route 12 on east to Coumarine City, whose Gym is a later part of plan 23 · Z3
    "kalos_route_12",
    "coumarine_city",
    // Plan 23 · Z4: the badlands, the north and east, the snow, the valleys, the woods, Victory Road and the League
    "kalos_route_13", "kalos_route_14", "laverre_city", "kalos_route_15", "dendemille_town", "kalos_route_17", "anistar_city",
    "kalos_route_18", "couriway_town", "kalos_route_19", "snowbelle_city", "kalos_route_20", "pokemon_village", "kalos_route_21",
    "kalos_victory_road", "kalos_pokemon_league"
  ]
}
