    { "key": "kalos_route_7", "about": "A walk along the river south and west of Camphrier, past meadows and flower beds." },
    { "key": "kalos_route_8", "about": "A cliff path along the sea between Cyllage City in the north and Ambrette Town in the south." },
    { "key": "cyllage_city", "flag": "FLAG_FIRST_ARRIVAL_CYLLAGE_CITY", "arrival": [ "cyllage_city" ], "about": "A town of terraces on the cliffs over a sandy bay, its Gym at the very top." },
    { "key": "kalos_route_10", "about": "A straight path north from Cyllage between two long lines of standing stones." },
    { "key": "geosenge_town", "flag": "FLAG_FIRST_ARRIVAL_GEOSENGE_TOWN", "arrival": [ "geosenge_town" ], "about": "A quiet town of a few houses beside an old ring of standing stones." },
