    { "key": "shalour_city", "flag": "FLAG_FIRST_ARRIVAL_SHALOUR_CITY", "arrival": [ "shalour_city" ], "about": "A city on the north-west coast, where the Tower of Mastery keeps the secret of Mega Evolution." },
    { "key": "ambrette_town", "flag": "FLAG_FIRST_ARRIVAL_AMBRETTE_TOWN", "arrival": [ "ambrette_town" ], "about": "A seaside town on a bay at the end of the cliff road, with an aquarium and a pier." },
