    { "key": "coumarine_city", "flag": "FLAG_FIRST_ARRIVAL_COUMARINE_CITY", "arrival": [ "coumarine_city" ], "about": "A garden city of flower beds on the south coast, whose Gym Leader is an old gardener." },
