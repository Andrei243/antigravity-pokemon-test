  "areas": [
    { "key": "unova_route_23", "about": "The last road, climbing north to the gate of Victory Road and the Pokémon League." },
    { "key": "unova_route_22", "about": "A rocky path by the sea, over a high catwalk and into a gorge." },
    { "key": "humilau_city", "flag": "FLAG_FIRST_ARRIVAL_HUMILAU_CITY", "about": "A coastal city of long boardwalks and glass buildings standing out over the water." },
    { "key": "dragonspiral_tower", "about": "A tall tower of grey stone standing alone in the cold, wrapped in old legends." },
    { "key": "unova_route_8", "about": "A cold, snowy road north from Icirrus City, toward the foot of a lonely tower." },
    { "key": "unova_route_9", "about": "A long bridge and road across a cold gorge, between Icirrus City and Opelucid City." },
    { "key": "opelucid_city", "flag": "FLAG_FIRST_ARRIVAL_OPELUCID_CITY", "about": "A city on a cliff, of white stone and tall towers, where old scholars and trainers meet." },
    { "key": "unova_route_12", "about": "A shore road down a long coast, ending in the harbour town of Lentimas." },
    { "key": "giant_chasm", "about": "A vast crater of ice and rock, where strange weather clings to the slopes." },
    { "key": "icirrus_city", "flag": "FLAG_FIRST_ARRIVAL_ICIRRUS_CITY", "arrival": [ "icirrus_city" ], "about": "A cold town of low wooden houses beside a frozen moor, quiet under the snow." },
    { "key": "unova_route_11", "about": "A short road of rock and wind just east of Opelucid City." },
    { "key": "lacunosa_town", "flag": "FLAG_FIRST_ARRIVAL_LACUNOSA_TOWN", "about": "A quiet old town at the foot of a hill, where doors are locked early after dark." },
    { "key": "unova_route_13", "about": "A stretch of marsh and rock between the coast and the valley of Lacunosa Town." },
    { "key": "twist_mountain", "about": "A great mountain of tunnels, caves and ledges, dug through a hillside of ice and rock." },
    { "key": "unova_route_21", "about": "A wave-washed strip of coast east of Undella Bay, open to the sea." },
    { "key": "unova_route_7", "about": "A windswept road across the western hills, toward Mistralton City and a tall old tower." },
    { "key": "mistralton_city", "flag": "FLAG_FIRST_ARRIVAL_MISTRALTON_CITY", "about": "A city beside an airfield on the western hills, where planes come and go all day." },
    { "key": "undella_bay", "about": "A broad bay of clear water, crossed in summer by swimmers and by ships." },
    { "key": "lentimas_town", "flag": "FLAG_FIRST_ARRIVAL_LENTIMAS_TOWN", "about": "A small harbour town on the eastern coast, with rock pools along its shore." },
    { "key": "reversal_mountain", "about": "A mountain with a cave inside it, warm in the south and cool in the north." },
    { "key": "undella_town", "flag": "FLAG_FIRST_ARRIVAL_UNDELLA_TOWN", "about": "A resort town of white sand and clear water on Undella Bay, busy with holidaymakers." },
    { "key": "chargestone_cave", "about": "A cave of floating stones and sparks of lightning drifting in the dark." },
    { "key": "unova_route_14", "about": "A shady valley path of old trees, rivers and the ruins of a lost village." },
    { "key": "unova_route_6", "about": "A rocky trail north from Driftveil City, with a cave mouth to the east." },
    { "key": "driftveil_city", "flag": "FLAG_FIRST_ARRIVAL_DRIFTVEIL_CITY", "about": "A port city of markets and cargo, whose drawbridge carries the road in from the east." },
    { "key": "unova_route_5", "about": "A road of fields that climbs to a long bridge between Nimbasa City and Driftveil City." },
    { "key": "unova_route_16", "about": "A shady road that leaves Nimbasa City by its gate and wanders on into a quiet wood." },
    { "key": "unova_route_15", "about": "A grassy road east of Nimbasa City, where trainers practise between the fields." },
    { "key": "nimbasa_city", "flag": "FLAG_FIRST_ARRIVAL_NIMBASA_CITY", "about": "A bright city of amusements, with a great wheel, a stadium and a theatre." },
    { "key": "pwt", "about": "A grand arena where trainers from far places meet to face one another in tournaments." },
    { "key": "desert_resort", "about": "A wide desert of dunes and sandstorms, with half-buried ruins under the shifting sand." },
    { "key": "unova_route_4", "about": "A dry road of dust and sunbaked stone, running up toward Nimbasa City and the desert." },
    { "key": "unova_route_3", "about": "A broad trail through grass and over a stream, winding on toward Nacrene City." },
    { "key": "pinwheel_forest", "about": "A cool forest of tall trees and plank walkways, where Pokémon rustle in the shade." },
    { "key": "nacrene_city", "flag": "FLAG_FIRST_ARRIVAL_NACRENE_CITY", "arrival": [ "nacrene_city" ], "about": "A city of old warehouses turned into studios and galleries, close beside the railway." },
    { "key": "striaton_city", "flag": "FLAG_FIRST_ARRIVAL_STRIATON_CITY", "arrival": [ "striaton_city" ], "about": "A city of gardens and old stone, with a famous restaurant near the green paths of Route 3." },
    { "key": "floccesy_ranch", "about": "A ranch of open pasture where Pokémon graze in the fields behind a low fence." },
    { "key": "virbank_city", "flag": "FLAG_FIRST_ARRIVAL_VIRBANK_CITY", "arrival": [ "virbank_city" ], "about": "A harbour town of docks and cranes, with a terminal for the ferries that cross the bay." },
    { "key": "unova_route_2", "about": "A road north from Route 1 through meadow and orchard, toward Striaton City." },
    { "key": "floccesy_town", "flag": "FLAG_FIRST_ARRIVAL_FLOCCESY_TOWN", "about": "A tiny farming town of cottages and a ranch gate, a little north of Aspertia City." },
    { "key": "unova_route_20", "about": "A shore path of ponds and reeds, north from Floccesy Town toward the docks of Virbank City." },
    { "key": "accumula_town", "flag": "FLAG_FIRST_ARRIVAL_ACCUMULA_TOWN", "arrival": [ "accumula_town" ], "about": "A small town with a plaza at its heart, where travellers stop to rest and talk." },
    { "key": "unova_route_19", "about": "A hillside lane that runs down from the gate of Aspertia City toward Floccesy Town." },
    { "key": "virbank_complex", "about": "A fenced field beside Virbank City, left to long grass and the wild Pokémon that live in it." },
    { "key": "unova_route_18", "about": "A broad open road of fields and fences, crossing toward the southern coast." },
    { "key": "unova_route_17", "about": "A sea route of long shoals and small islets, with only a laboratory to rest at." },
    { "key": "p2_laboratory", "about": "A grey research laboratory on the shore, where Pokémon are studied behind locked doors." },
    { "key": "unova_route_1", "about": "The first road out of Nuvema Town: tall grass, wild Pokémon and the first trainers." },
    { "key": "aspertia_city", "flag": "FLAG_FIRST_ARRIVAL_ASPERTIA_CITY", "about": "A hill town in the far south-west, its school and Gym high above the road." },
    { "key": "liberty_garden", "about": "A small island garden out in the bay, reached by ferry once the Champion has won the title." },
    { "key": "nuvema_town", "flag": "FLAG_FIRST_ARRIVAL_NUVEMA_TOWN", "arrival": [ "nuvema_town" ], "about": "A small, quiet town by the south-eastern shore, home to the professor who studies Pokémon origins." },
    { "key": "castelia_city", "flag": "FLAG_FIRST_ARRIVAL_CASTELIA_CITY", "arrival": [ "CasteliaCity", "castelia_city_2", "castelia_city_3", "castelia_city_4", "castelia_city_5", "castelia_city_6", "castelia_city_7", "castelia_city_10", "castelia_city_12" ], "about": "A big port city of piers and towers on the bay, reached by ship from Virbank City." }
