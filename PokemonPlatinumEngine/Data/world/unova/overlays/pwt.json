    { "id": "hugh_pier", "name": "{rival}", "npcType": "hugh", "x": 196, "y": 488, "facing": "Down", "hiddenBy": "FLAG_UNOVA_HIDE_HUGH_PWT_PIER" },
    { "id": "cheren_pier", "name": "Cheren", "npcType": "cheren", "x": 198, "y": 488, "facing": "Down", "hiddenBy": "FLAG_UNOVA_HIDE_CHEREN_PWT_PIER" }
