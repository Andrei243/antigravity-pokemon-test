    "0": { "name": "Lena", "trainer": { "dialogueBefore": "Rangers keep these hills safe. Let me see if you're safe to let through!", "dialogueAfter": "You're more than safe. You're dangerous." } },
    "1": { "name": "Doug", "trainer": { "dialogueBefore": "Everyone on this road is bound for the League. Me, I'm bound for the next rock!", "dialogueAfter": "That rock can wait. I need a sit-down." } },
    "2": { "name": "Tom", "trainer": { "dialogueBefore": "Only Trainers with eight Badges come this far. Show me yours were earned!", "dialogueAfter": "Earned, every one of them." } },
    "3": { "name": "Miki", "trainer": { "dialogueBefore": "One more battle before Victory Road? Don't mind if I do!", "dialogueAfter": "I'll walk the road behind you, then." } },
    "4": { "name": "Benjamin", "trainer": { "dialogueBefore": "My training ends at the League's door. Yours ends here!", "dialogueAfter": "My training goes on, it seems." } },
    "5": { "name": "Tiffany", "trainer": { "dialogueBefore": "I run up and down this valley every morning. Keep up with me!", "dialogueAfter": "You didn't even break a sweat!" } },
    "23": { "name": "Juliet", "trainer": { "dialogueBefore": "The river's loud, but my Pokémon are louder!", "dialogueAfter": "Drowned out completely." } },
    "25": { "name": "Don", "trainer": { "dialogueBefore": "I've climbed every hill on Route 23. Now let's see you climb past me!", "dialogueAfter": "Over the top, just like that." } },
    "26": { "name": "Luke", "trainer": { "dialogueBefore": "Hiyah! A Trainer at the end of the road must be strong. Prove it!", "dialogueAfter": "Proven. Painfully." } },
    "28": { "name": "Grant", "trainer": { "dialogueBefore": "I came to watch the challengers go by. Then I thought: why not battle one?", "dialogueAfter": "I'll go back to watching, I think." } },
