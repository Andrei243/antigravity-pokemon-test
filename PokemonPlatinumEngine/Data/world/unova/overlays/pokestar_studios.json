  "props": [ { "type": "PosterWall", "x": 22, "y": 21, "width": 3, "depth": 1 } ],
  "readAt": [ { "x": 22, "z": 21, "script": "PosterWall" }, { "x": 23, "z": 21, "script": "PosterWall" }, { "x": 24, "z": 21, "script": "PosterWall" } ],
  "people": {
    "1": {
      "name": "Painter",
      "npcType": "artist",
      "dialog": [ "I paint the studio's posters. Reds, always warm reds! A poster should feel like the lights going down." ]
    },
    "2": {
      "name": "Fan",
      "npcType": "pokefan_m",
      "dialog": [ "I come every week hoping to see someone famous. Today I saw a Pokémon in a top hat. Close enough!" ]
    },
    "10": {
      "name": "Set Painter",
      "npcType": "artist",
      "dialog": [ "This fence was a castle wall last week. Next week it'll be a mountain pass in a thunderstorm." ]
    },
    "11": {
      "name": "Clown",
      "npcType": "harlequin",
      "dialog": [ "I play the comic relief in every film nobody has written yet. It's very restful work." ]
    },
    "12": {
      "name": "Fan",
      "npcType": "pokefan_f",
      "dialog": [ "The premieres at the theater are the best! The crowd gasps at every twist, even on a second showing." ]
    },
    "17": {
      "name": "Fan",
      "npcType": "pokefan_m",
      "dialog": [ "The studio building is where the takes are shot. Tell the director I said hello!" ]
    },
    "19": {
      "name": "Fan",
      "npcType": "pokefan_m",
      "dialog": [ "A good take depends on the lines you choose as much as the moves you pick. Trust me, I've watched hundreds." ]
    }
  }
