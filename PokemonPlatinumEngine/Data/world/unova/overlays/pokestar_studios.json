  "area": "pokestar_studios",
  "name": "Pokéstar Studios",
  "bgmTrack": "unova/pokestar_studios",
  "read": { "34": "PosterWall" },
  // The poster wall itself (plan 42 · PS4, part b, the user's 33a): a hoarding of the four films in warm reds standing
