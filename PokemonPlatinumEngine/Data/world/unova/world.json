{
  // What is built of Unova so far (plan 22). The maps are Black 2's, read by tools/MapImporter's third DS reader
  // (plan 22 · U1, U2: --game black2) from fuddlesworth/pokebw2; "maps" are the maps the game makes from its matrices,
  // "areas" the areas open to walk in. After adding an area, run `dotnet run --project tools/MapImporter -- --game black2
  // --data` and write its overlay (overlays/<key>.json). Unova's keys are Black 2's zone constants without ZONE_, lower
  // case (aspertia_city, floccesy_town), but a route's, Victory Road's and the League's take the region's name, since
  // Kanto's routes have the same numbers (unova_route_19). A room is a matrix of its own ("Indoors"), several rooms
  // sharing one: each has a map of its own, told apart by its area.
  "region": "Unova",
  "maps": [
    // The overworld: Black 2's OVERWORLD matrix, 29 by 27 chunks
    { "name": "Unova", "matrix": 0, "trees": "Round" },
    // Plan 22 · U2: Aspertia City's rooms, its gate to Route 19, and its school with the Gym behind it
    { "name": "AspertiaCity_PlayersHouse", "matrix": 257, "area": "aspertia_city_2", "trees": "Round", "setting": "Indoors" },
    { "name": "AspertiaCity_House1_1F", "matrix": 406, "area": "aspertia_city_3", "trees": "Round", "setting": "Indoors" },
