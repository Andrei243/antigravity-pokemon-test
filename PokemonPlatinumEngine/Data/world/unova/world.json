  // What is built of Unova so far (plan 22). The maps are Black 2's, read by tools/MapImporter's third DS reader
  // (plan 22 · U1, U2: --game black2) from fuddlesworth/pokebw2; "maps" are the maps the game makes from its matrices,
  // "areas" the areas open to walk in. After adding an area, run `dotnet run --project tools/MapImporter -- --game black2
  // --data` and write its overlay (overlays/<key>.json). Unova's keys are Black 2's zone constants without ZONE_, lower
  // case (aspertia_city, floccesy_town), but a route's, Victory Road's and the League's take the region's name, since
  // Kanto's routes have the same numbers (unova_route_19). A room is a matrix of its own ("Indoors"), several rooms
  // sharing one: each has a map of its own, told apart by its area.
  "region": "Unova",
  // Plan 22 · U8: Opelucid City under the Plasma Frigate's ice. The five chunks of the city have twins written by the importer (their
  // numbers plus 2000: the same tiles with made ground ice and bare ground snow), which lie in their cells while the story's flag is
  // set (the mechanism of a season's chunks and of Hoenn's tide), and the city's overlay lays its snow and its cold over it
  "swaps": [
    { "map": "Unova", "flag": "FLAG_UNOVA_OPELUCID_ICE", "cells": [ { "chunkX": 11, "chunkY": 4, "chunk": 2104 }, { "chunkX": 12, "chunkY": 4, "chunk": 2074 }, { "chunkX": 13, "chunkY": 4, "chunk": 2076 }, { "chunkX": 12, "chunkY": 5, "chunk": 2075 }, { "chunkX": 13, "chunkY": 5, "chunk": 2077 } ] },
    // Plan 29 · LS11d: the Liberty Garden (cell 9, 23) is an island Black 2 sets apart with no chunk round it, where the world grows
    // forest; the importer's sea (chunk 3000) is laid in the eight cells round it once it can be come to, by Unova's Champion
    { "map": "Unova", "flag": "UnovaHallOfFame", "cells": [ { "chunkX": 8, "chunkY": 22, "chunk": 3000 }, { "chunkX": 9, "chunkY": 22, "chunk": 3000 }, { "chunkX": 10, "chunkY": 22, "chunk": 3000 }, { "chunkX": 8, "chunkY": 23, "chunk": 3000 }, { "chunkX": 10, "chunkY": 23, "chunk": 3000 }, { "chunkX": 8, "chunkY": 24, "chunk": 3000 }, { "chunkX": 9, "chunkY": 24, "chunk": 3000 }, { "chunkX": 10, "chunkY": 24, "chunk": 3000 } ] }
