    { "key": "cabo_poco", "flag": "FLAG_FIRST_ARRIVAL_CABO_POCO", "about": "A village of white houses on the cliffs of the far south-west, looking out over the sea." },
    { "key": "poco_path", "about": "A path down from the cliffs past a lighthouse and a hidden beach, north toward Los Platos." },
    { "key": "los_platos", "flag": "FLAG_FIRST_ARRIVAL_LOS_PLATOS", "about": "A small crossroads town of farms and a Pokémon Center, on the road north to Mesagoza." },
    { "key": "south_province_area_one", "about": "Open fields and gentle hills below Mesagoza, where young Pokémon graze in the grass." },
    { "key": "mesagoza", "about": "The great old city on the hill, with the academy at the head of its stairs." },
    { "key": "south_province_area_two", "about": "The road west out of Mesagoza between the hills, to the olive groves of Cortondo." },
    { "key": "cortondo", "flag": "FLAG_FIRST_ARRIVAL_CORTONDO", "about": "An olive-growing town of groves and a bakery. Katy, the Bug-type gym leader, keeps its gym." },
    { "key": "south_province_area_three", "about": "The road east out of Mesagoza between the hills, to the flower fields of Artazon." },
    { "key": "artazon", "flag": "FLAG_FIRST_ARRIVAL_ARTAZON", "about": "A town of flower fields and sculptures. Brassius, the Grass-type gym leader, keeps its gym." },
    { "key": "east_province_area_one", "about": "The road north from Artazon along the eastern hills, toward the sea and Levincia." },
    { "key": "levincia", "flag": "FLAG_FIRST_ARRIVAL_LEVINCIA", "about": "A bright city on the eastern sea. Iono, the Electric-type gym leader, streams from its gym." },
    { "key": "quaking_earth", "about": "A dusty basin north of Cortondo, at the desert's edge, where the ground is said to shake." },
    { "key": "asado_desert", "about": "Sand and dunes north of Cortondo, crossed by the road to Cascarrafa and the road east to Medali." },
    { "key": "cascarrafa", "flag": "FLAG_FIRST_ARRIVAL_CASCARRAFA", "about": "A city of falls and markets under the hills. Kofu, the Water-type gym leader, cooks at its gym." },
    { "key": "west_province_area_two", "about": "The road west out of Cascarrafa over the hills, down to the sea at Porto Marinada." },
    { "key": "porto_marinada", "flag": "FLAG_FIRST_ARRIVAL_PORTO_MARINADA", "about": "A market port on the western sea, where the morning's catch is sold at auction on the quay." },
    { "key": "west_province_area_one", "about": "The road east out of Asado Desert between the hills, past a gully the birds keep clear of, to Medali." },
    { "key": "medali", "flag": "FLAG_FIRST_ARRIVAL_MEDALI", "about": "A quiet town known for its Treasure Eatery. Larry, the Normal-type gym leader, keeps its gym." }
