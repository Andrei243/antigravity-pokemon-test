{
  // Pallet Town (plan 19 · K1): FireRed's map, our words. Professor Oak's scene at the edge of the grass, which the
  // two triggers north of town start, is plan 19 · K3's (pallet_town.txt)
  "area": "pallet_town",
  // A spot where the player's home opens (plan 43 · LF7): a blocked tile with open ground before it
  "baseSpots": [ { "x": 62, "z": 261, "kind": "Tree", "room": 1 } ],
  // The photo spot's plate (plan 43 · LF4, laid by LF7's session), read from the tile before it
  "props": [ { "type": "PhotoSpot", "x": 63, "y": 271, "width": 1, "depth": 1 } ],
  // The photo spot's plate (plan 43 · LF4, laid by LF7's session), read from the tile before it
  "readAt": [ { "x": 63, "z": 271, "script": "PhotoSpot" } ],

  // Plan 40 · GE3: LeafGreen's Staryu on the Super Rod, once the National Pokédex is had

  "national": { "superRod": [ "Staryu" ] },
  "bgmTrack": "kanto/pallet",
  "trees": "Round",
  "architecture": "Clapboard",
  "triggers": [ { "trigger": 0, "script": "OakStops" }, { "trigger": 1, "script": "OakStops" } ],
  "people": {
    "pallet_prof_oak": { "name": "Prof. Oak", "still": true, "dialog": [ "Wild Pokémon live in that grass. Stay close!" ] },
    "pallet_sign_lady": {
      "name": "Neighbour",
      "dialog": [
        "I grow flowers by the fence there. Pokémon from Route 1 come down to sniff them some mornings.",
        "If you keep still, they don't run off!"
      ]
    },
    "pallet_fat_man": {
      "name": "Neighbour",
      "dialog": [
        "Did you know you can keep Pokémon inside a computer? Any PC will look after them for you.",
        "Times have changed since I was young, I tell you."
      ]
    }
  },
  // The signposts, by the original's script each runs: what each says is ours
  "signs": {
    "PalletTown_EventScript_TownSign": "Pallet Town\nA quiet place to set out from.",
    "PalletTown_EventScript_PlayersHouseSign": "{player}'s House",
    "PalletTown_EventScript_RivalsHouseSign": "{rival}'s House",
    "PalletTown_EventScript_OaksLabSign": "Professor Oak's\nPokémon Research Lab",
    "PalletTown_EventScript_TrainerTips": "TRAINER TIPS\nPress Enter to open the menu.\nYou can save your game there at any time."
  }
}
