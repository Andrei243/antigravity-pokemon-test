    { "name": "PalletTown_PlayersHouse_1F", "matrix": 201, "area": "pallet_town_players_house_1f", "trees": "Round", "setting": "Indoors" },
    { "name": "PalletTown_PlayersHouse_2F", "matrix": 202, "area": "pallet_town_players_house_2f", "trees": "Round", "setting": "Indoors" },
