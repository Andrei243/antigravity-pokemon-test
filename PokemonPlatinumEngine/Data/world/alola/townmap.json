  "cursor": [ 0, 0, 27, 25 ],
  "start": [ 7, 3 ],
  "hidden": [],
  "areas": [
    { "key": "alola_route_3", "about": "A cliff road above the sea in Melemele's north, over a gorge on a narrow bridge." },
    { "key": "melemele_meadow", "about": "A quiet field of yellow flowers at the end of Route 3, where small birds flit about." },
    { "key": "mahalo_trail", "about": "A path climbing from Iki Town to the ruins where Melemele's guardian keeps watch." },
    { "key": "iki_town", "flag": "FLAG_FIRST_ARRIVAL_IKI_TOWN", "arrival": [ "iki_town" ], "about": "A village on a hill round a wooden stage, home of the island's kahuna and its festival." },
    { "key": "alola_route_2", "about": "A road north out of Hau'oli past berry fields, a Pokémon Center and a cave's mouth." },
    { "key": "alola_route_1", "about": "A road of palms and lawns from the professor's beach up to Iki Town, past the player's home." },
    { "key": "hauoli_city", "flag": "FLAG_FIRST_ARRIVAL_HAUOLI_CITY", "about": "Melemele's big city by the sea: shops, a beach, a city hall and a busy marina." },
    { "key": "po_town", "flag": "FLAG_FIRST_ARRIVAL_PO_TOWN", "arrival": [ "po_town" ], "about": "A grey town behind a high wall, overrun by Team Skull and soaked by endless rain." },
    { "key": "ulaula_route_16", "about": "A short road from Po Town's gate down toward the coast and an old wooden house." },
    { "key": "lanakila_foot", "about": "A narrow pass between cliffs, climbing to the mouth of the snowy Mount Lanakila." },
    { "key": "mount_hokulani", "about": "A mountain road up to the observatory at its top, where the stars seem close." },
    { "key": "ulaula_route_12", "about": "A rocky road of wind and lava stones, best crossed on the back of a sure-footed Pokémon." },
    { "key": "tapu_village", "flag": "FLAG_FIRST_ARRIVAL_TAPU_VILLAGE", "about": "A village half washed away by a storm long ago, near an old shop that ghosts now haunt." },
    { "key": "ulaula_route_13", "about": "A road along the shore past a motel and a beach, to the foot of Mount Lanakila." },
    { "key": "ulaula_route_10", "about": "A road out of Malie with a bus stop that no bus ever seems to come to." },
    { "key": "malie_city", "flag": "FLAG_FIRST_ARRIVAL_MALIE_CITY", "about": "An old city of red roofs, stone lanterns and a calm garden, Ula'ula's port." },
    { "key": "wela_volcano_park", "about": "A trail up the slopes of a living volcano to the trial site at its rim." },
    { "key": "brooklet_hill", "about": "Streams and two still lakes on a green hill, where a Captain holds her trial." },
    { "key": "akala_route_5", "about": "A road north through the fields from the ranch, with a Pokémon Center by the way." },
    { "key": "lush_jungle", "about": "A thick, damp forest of giant leaves and hidden paths, its air sweet with flowers." },
    { "key": "akala_route_8", "about": "A coastal road of bright red earth beside the sea, with a motel and a Pokémon Center." },
    { "key": "akala_route_7", "about": "A black sand beach where the waves break on dark rocks below the volcano." },
    { "key": "akala_outskirts", "about": "A windy cape at Akala's edge, past the ruins and a lone house by the sea." },
    { "key": "paniola_ranch", "about": "Wide paddocks of grazing Pokémon, where Paniola's ranchers train their herds." },
    { "key": "paniola_town", "flag": "FLAG_FIRST_ARRIVAL_PANIOLA_TOWN", "about": "A ranching town of wooden fences and a big barn, under the slopes of Akala's peak." },
    { "key": "akala_route_6", "about": "A road between the hills from Paniola down to Royal Avenue's lights." },
    { "key": "royal_avenue", "about": "A lively avenue of shops and stands round the Battle Royal Dome." },
    { "key": "akala_route_9", "about": "A short road of rock and sea between Diglett's Tunnel and Konikoni City." },
    { "key": "memorial_hill", "about": "A quiet hill of graves above the sea, where people come to remember." },
    { "key": "akala_route_4", "about": "A road north from Heahea between farms and fruit trees, toward Paniola Town." },
    { "key": "konikoni_city", "flag": "FLAG_FIRST_ARRIVAL_KONIKONI_CITY", "about": "A seaside city of lanterns and little shops, where the kahuna sells stones." },
    { "key": "hano_beach", "about": "A long white beach before the grand resort, with clear blue water." },
    { "key": "heahea_city", "flag": "FLAG_FIRST_ARRIVAL_HEAHEA_CITY", "about": "Akala's busy port, with a grand hotel, shops and the ferries to the other islands." },
    { "key": "exeggutor_island", "about": "A rocky island across the strait, where very tall Exeggutor sway in the sun." },
    { "key": "poni_breakers", "about": "A wild shore of crashing waves on Poni, near the ruins of the sea's guardian." },
    { "key": "poni_wilds", "about": "Grassy cliffs and rocks along the shore north of Seafolk Village." },
    { "key": "seafolk_village", "flag": "FLAG_FIRST_ARRIVAL_SEAFOLK_VILLAGE", "about": "A village of houseboats moored together, where the people of the sea live." }
