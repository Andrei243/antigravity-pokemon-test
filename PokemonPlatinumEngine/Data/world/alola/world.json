{
  // What is built of Alola so far (plan 23 · Z5, first part). Sun and Moon have no decompilation that holds their maps and
  // no dump is read, so Alola is drawn by hand on the tile grid as Kalos is (the user's decision of 2026-11-02): the
  // drawings are tools/MapDraw/alola, and `dotnet run --project tools/MapDraw -- alola` writes the chunks, the matrix and
  // the habitats here from them. The area files, the overlays and this index are written by hand. The rooms are
  // hand-made map files (Data/maps), reached by the overlays' doors. Alola's keys are the places' names in lower case,
  // a route's taking the region's name, since Kanto's and Kalos's routes have the same numbers (alola_route_1).
  "region": "Alola",
  // The houses are drawn into the tiles, each found at its door (WorldMapBuilder.BuildingsAtDoors), as Kalos's are
  "buildingsAtDoors": true,
  "maps": [
    // Melemele Island, the first of the four islands (each a matrix of its own, plan 23's Alola decisions): 16 chunks by
    // 16, Iki Town on its hill near the middle
    { "name": "Melemele", "matrix": 0, "trees": "Round" },
    // Plan 23 · Z5, second part: Melemele's two caves, maps of their own: Ten Carat Hill off Route 1's shore and
    // Verdant Cavern, Captain Ilima's trial, off Route 2
    { "name": "TenCaratHill", "matrix": 1, "area": "ten_carat_hill", "trees": "Round", "setting": "Cave" },
    { "name": "VerdantCavern", "matrix": 2, "area": "verdant_cavern", "trees": "Round", "setting": "Cave" },
    // Akala Island, the second island, a matrix of its own: Heahea City to Brooklet Hill so far. The ferry from Hau'oli's
    // marina lands on Heahea's pier (hauoli_city.txt, heahea_city.txt)
    { "name": "Akala", "matrix": 3, "trees": "Round" },
    // Plan 23 · Z6: Diglett's Tunnel under Akala, between Route 8 and Route 9, a map of its own (matrix 20, clear of the
    // islands' numbers)
    { "name": "DiglettsTunnel", "matrix": 20, "area": "digletts_tunnel", "trees": "Round", "setting": "Cave" }
  ],
  "areas": [
    "alola_route_1",
    "iki_town",
    "mahalo_trail",
    "hauoli_city",
    "alola_route_2",
    "alola_route_3",
    "melemele_meadow",
    "ten_carat_hill",
    "verdant_cavern",
    "heahea_city",
    "akala_route_4",
    "paniola_town",
    "paniola_ranch",
    "akala_route_5",
    "brooklet_hill",
    // Plan 23 · Z6: the rest of Akala
    "akala_route_6",
    "royal_avenue",
    "akala_route_8",
    "lush_jungle",
    "akala_route_7",
    "wela_volcano_park",
    "digletts_tunnel",
    "akala_route_9",
    "konikoni_city",
    "memorial_hill",
    "akala_outskirts",
    "hano_beach"
  ]
