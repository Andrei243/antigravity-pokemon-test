  "signboards": [
    {
      "x": 1,
      "y": 11,
      "text": "A guide to the Pokétch's clocks.\nThe Digital Watch and the Analog Watch tell the time, and the Stopwatch and the Kitchen Timer measure it.\nThe Alarm Clock rings at the hour it is set for, and the Calendar keeps the dates worth remembering."
    },
    {
      "x": 9,
      "y": 11,
      "text": "A guide to the Pokétch's helpers.\nThe Calculator does sums, the Memo Pad takes notes, the Pokémon History recalls Pokémon met and the Berry Searcher finds Berries. The Friendship Checker, Day-Care Checker and Matchup Checker tell how Pokémon feel."
    },
    {
      "x": 15,
      "y": 11,
      "text": "A guide to the Pokétch's pastimes.\nThe Pokémon List shows how the team is doing, and the Dot Artist draws. The Coin Toss and the Roulette decide what nobody can, the Color Changer recolours the screen, and the Marking Map marks a map of Sinnoh."
    },
    {
      "x": 1,
      "y": 4,
      "text": "A guide to the Pokétch's counters and finders.\nThe Pedometer counts steps, and the Counter anything at all. The Dowsing Machine finds what lies hidden, the Trainer Counter follows Poké Radar chains, the Link Searcher finds players, and the Move Tester tests types."
    }
  ],
  "npcs": [
    {
      "id": "ninja_boy",
      "name": "Ninja Boy",
      "npcType": "Youngster",
      "x": 7,
      "y": 5,
      "facing": "Right",
      "dialog": [
        "Have you got a Pokétch?",
        "There's one model for girls and one for boys, and they come in different colours."
      ],
      "movement": "wander_around",
      "rangeX": 2
    },
    {
      "id": "pokefan_f",
      "name": "Woman",
      "npcType": "Lady",
      "x": 14,
      "y": 6,
      "facing": "Left",
      "dialog": [
        "My husband is the president.",
        "We started out in a poky little workshop where he made whatever took his fancy.",
        "And now we make something the whole world is glad of. Just imagine!"
      ],
      "movement": "look_around"
    },
    {
      "id": "expert_f",
      "name": "Old Lady",
      "npcType": "Lady",
      "x": 3,
      "y": 6,
      "facing": "Left",
      "dialog": [
        "People all over Sinnoh make Pokétch apps of their own.",
        "You may be given one where you least expect it.",
        "The PCs on this floor have a guide to every one of them."
      ],
      "movement": "look_north_south_and_west"
    }
  ],
