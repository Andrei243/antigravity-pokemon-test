    {
      "x": 31,
      "y": 18,
      "text": "Team Galactic TV Room\nThe finest sound and picture there is, for members only. Onward to a new universe!",
      "script": "Notice"
    },
    {
      "x": 9,
      "y": 19,
      "text": "A notice on the wall:\n\"Team Galactic's creed! All that there is belongs to Team Galactic. Lift your eyes past this world: the stars shall be Team Galactic's too!\"",
      "script": "Notice"
    },
    {
      "x": 39,
      "y": 14,
      "text": "A note is taped to the fridge:\n\"Drink your fill, and find the strength to drive us on!\"\nInside there is nothing but bottles of something murky...",
      "script": "Notice"
    },
    {
      "x": 41,
      "y": 12,
      "text": "A note is pinned up over the sink:\n\"Eat what you love, and thrive!\"\nSomething nobody could put a name to has dried in a crust all round the basin...",
      "script": "Notice"
    },
    {
      "x": 42,
      "y": 12,
      "text": "A note is pinned up over the sink:\n\"Eat what you love, and thrive!\"\nSomething nobody could put a name to has dried in a crust all round the basin...",
      "script": "Notice"
    },
    {
      "x": 41,
      "y": 17,
      "text": "A report lies on the table: \"The Pokémon Statue of Eterna City\".",
      "script": "Report"
    }
