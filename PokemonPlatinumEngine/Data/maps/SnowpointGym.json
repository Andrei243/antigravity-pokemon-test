        "id": "ace_trainer_brenna",
        "name": "Brenna",
        "trainerClass": "Ace Trainer",
        "party": [],
        "prizeMoney": 300,
        "dialogueBefore": "Ace Trainer Brenna: The middle of the Gym is its lowest point. Everything slides down to it sooner or later!",
        "dialogueAfter": "Ace Trainer Brenna: This time I was the one who slid... Candice is waiting at the very top.",
        "sightRange": 1
      }
    },
