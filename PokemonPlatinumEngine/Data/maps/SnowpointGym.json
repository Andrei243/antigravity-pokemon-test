      "y": 3,
      "facing": "Down",
      "trainer": {
        "id": "ace_trainer_anton",
        "name": "Anton",
        "trainerClass": "Ace Trainer",
        "party": [],
        "prizeMoney": 300,
        "dialogueBefore": "Ace Trainer Anton: Up here by the dais the ice is at its slickest. Think you can keep your footing in a battle?",
        "dialogueAfter": "Ace Trainer Anton: I slipped up... Nobody climbs to Candice without a running start from down below.",
        "sightRange": 1
      },
      "movement": "look_south_and_east"
    },
    {
      "id": "ace_trainer_savannah",
      "name": "Savannah",
      "npcType": "Lass",
      "x": 21,
      "y": 9,
      "facing": "Left",
      "trainer": {
        "id": "ace_trainer_savannah",
        "name": "Savannah",
        "trainerClass": "Ace Trainer",
        "party": [],
        "prizeMoney": 300,
        "dialogueBefore": "Ace Trainer Savannah: Kids in Snowpoint learn to slide before they learn to walk. Every slope here is a running start!",
        "dialogueAfter": "Ace Trainer Savannah: Melted! You've got the ice figured out, haven't you?",
        "sightRange": 1
      },
      "movement": "look_north_south_and_west"
    },
    {
      "id": "ace_trainer_alicia",
      "name": "Alicia",
      "npcType": "Lass",
      "x": 3,
      "y": 6,
      "facing": "Right",
      "trainer": {
        "id": "ace_trainer_alicia",
        "name": "Alicia",
        "trainerClass": "Ace Trainer",
        "party": [],
        "prizeMoney": 300,
        "dialogueBefore": "Ace Trainer Alicia: My Sneasel skate over the ice without making a sound. Can you say the same?",
        "dialogueAfter": "Ace Trainer Alicia: Hmph. Their claws were sharp, but your focus was sharper.",
        "sightRange": 1
      }
    },
    {
      "id": "ace_trainer_isaiah",
      "name": "Isaiah",
      "npcType": "Youngster",
      "x": 18,
      "y": 15,
      "facing": "Down",
      "trainer": {
        "id": "ace_trainer_isaiah",
        "name": "Isaiah",
        "trainerClass": "Ace Trainer",
        "party": [],
        "prizeMoney": 300,
        "dialogueBefore": "Ace Trainer Isaiah: It takes speed to smash those snowballs. Speed, and a little nerve!",
        "dialogueAfter": "Ace Trainer Isaiah: Bowled over! Remember: a slope down gives you speed, a slope up takes it away.",
        "sightRange": 1
      }
    },
    {
      "id": "ace_trainer_brenna",
      "name": "Brenna",
      "npcType": "Lass",
      "x": 5,
      "y": 16,
      "facing": "Up",
