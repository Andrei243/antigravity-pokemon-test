    {
      "id": "battle_girl",
      "name": "Battle Girl",
      "npcType": "Lass",
      "x": 10,
      "y": 6,
      "facing": "Left",
      "dialog": [
        "Did you know? About my PC Box, I mean. It is full of Pokémon everybody longs for, such as...",
