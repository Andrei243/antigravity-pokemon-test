      "dialog": [
        "The Hiker enjoying the Box Data down on 2F? That's my little brother."
      ]
    },
    {
      "id": "guitarist",
      "name": "Guitarist",
      "npcType": "Youngster",
      "x": 15,
      "y": 10,
      "facing": "Left",
      "dialog": [
        "Let me try the alphabet rap on Jubilife, dig?",
        "J... Just south of here sits Sandgem by the sea. U... Under Oreburgh, a mine goes deep as deep can be.",
        "B... Beyond the gate the road runs east. I... In the north, Floaroma's flowers are a feast. L... I've lost the beat. Sorry!"
      ],
      "movement": "wander_around",
      "rangeZ": 2
    },
    {
      "id": "school_kid_f",
      "name": "School Kid",
      "npcType": "Lass",
      "x": 6,
      "y": 6,
      "facing": "Up",
      "dialog": [
        "It's such a good idea. Anybody at all can join in.",
        "Even a battle you lost might turn out to be somebody's favourite Battle Video."
      ],
      "movement": "look_north_and_west"
    },
    {
      "id": "camper",
      "name": "Camper",
      "npcType": "Youngster",
      "x": 4,
      "y": 11,
      "facing": "Right",
      "dialog": [
        "What a collection! I can see why everyone comes here.",
        "I feel tougher just for having watched a few of these."
      ]
    },
    {
      "id": "youngster",
      "name": "Youngster",
      "npcType": "youngster",
      "x": 6,
      "y": 5,
      "facing": "Down",
      "dialog": [
        "What you see here is how much people all over the world love Pokémon.",
        "Watch their Battle Videos, and you share in the fun they had."
      ],
      "movement": "look_south_and_west"
    },
    {
      "id": "pokefan_m",
      "name": "Man",
      "npcType": "Gentleman",
      "x": 4,
      "y": 10,
      "facing": "Right",
      "dialog": [
        "My favourite Battle Videos are the ones with a sweet little Clefairy in them. Only those."
      ]
    },
    {
      "id": "clown",
      "name": "Clown",
      "npcType": "clown",
      "x": 11,
      "y": 10,
      "facing": "Left",
      "dialog": [
        "My favourite Battle Video! My favourite Battle Video!",
        "What's on it? What's on it? It's a secret! It's a secret! And I mean it!"
      ],
      "movement": "wander_around",
      "rangeZ": 1
    },
    {
      "id": "ace_trainer_m",
      "name": "Ace Trainer",
      "npcType": "Youngster",
      "x": 9,
      "y": 6,
      "facing": "Left",
      "dialog": [
        "This Battle Video is something else!",
        "One Pokémon left, a hair from being wiped out, and they turned the whole thing round!"
      ]
    }
