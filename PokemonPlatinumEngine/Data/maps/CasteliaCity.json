    {
      "name": "Clerk",
      "npcType": "Clerk",
      "x": 22,
      "y": 7,
      "facing": "Down",
      "dialog": [
        "Everyone on this avenue walks so fast. If you stand still, the crowd just flows round you like a river."
      ]
    },
    {
      "name": "Youngster",
      "npcType": "Youngster",
      "x": 34,
      "y": 9,
      "facing": "Left",
      "dialog": [
        "The towers here are so tall, I get a crick in my neck. My Pidove says the view from the top is amazing."
      ]
    },
    {
      "name": "Lady",
      "npcType": "Lady",
      "x": 55,
      "y": 8,
      "facing": "Down",
      "dialog": [
        "Castelia is the biggest city in Unova. People come from every corner of the region to work here."
      ]
    },
    {
      "name": "Clerk",
      "npcType": "Clerk",
      "x": 68,
      "y": 7,
      "facing": "Down",
      "dialog": [
        "I'm due at the office in five minutes, and the lift always takes forever. Wish me luck!"
      ]
    },
    {
      "name": "Ace Trainer",
      "npcType": "ace_trainer_f",
      "x": 77,
      "y": 9,
      "facing": "Right",
      "dialog": [
        "Burgh's Gym is up Gym Street. They say his Bug types get stronger the more you underestimate them."
      ]
    }
  ],
