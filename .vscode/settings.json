{
  // Plan 24 · X4: each hand-written data file is checked against its schema as it is written (docs/schemas, made by
  // PokemonPlatinumTests' SchemaTests). The game reads these files strictly, so a key the schema refuses would stop it.
  "json.schemas": [
    { "fileMatch": ["PokemonPlatinumEngine/Data/world/*/world.json"], "url": "./docs/schemas/world.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world/*/overlays/*.json"], "url": "./docs/schemas/overlay.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/maps/*.json"], "url": "./docs/schemas/map.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/audio/sound-map.json"], "url": "./docs/schemas/sound-map.schema.json" },
    { "fileMatch": ["**/overrides/models/*.json", "assets/models/*.json"], "url": "./docs/schemas/model-options.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/charms.json"], "url": "./docs/schemas/charms.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/open-wild.json"], "url": "./docs/schemas/open-wild.schema.json" },
    { "fileMatch": ["tools/DataImporter/Overrides/species.json"], "url": "./docs/schemas/species-patch.schema.json" },
    { "fileMatch": ["tools/DataImporter/Overrides/items.json"], "url": "./docs/schemas/items-patch.schema.json" },
    { "fileMatch": ["tools/DataImporter/Overrides/moves.json"], "url": "./docs/schemas/moves-patch.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/materials.json"], "url": "./docs/schemas/materials.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/card-looks.json"], "url": "./docs/schemas/card-looks.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/photo-spots.json"], "url": "./docs/schemas/photo-spots.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/recipes.json"], "url": "./docs/schemas/recipes.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/powers.json"], "url": "./docs/schemas/powers.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/training.json"], "url": "./docs/schemas/training.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/facility-trainers.json"], "url": "./docs/schemas/facility-trainers.schema.json" },
    { "fileMatch": ["tools/DataImporter/Overrides/facility-sets.json"], "url": "./docs/schemas/facility-sets-patch.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/world.json", "tools/OpenWorldBake/worlds/*/world.json"], "url": "./docs/schemas/open-world.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/terrain/*.json", "tools/OpenWorldBake/worlds/*/terrain/*.json"], "url": "./docs/schemas/open-terrain.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/carve/*.json", "tools/OpenWorldBake/worlds/*/carve/*.json"], "url": "./docs/schemas/open-carve.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/water.json", "tools/OpenWorldBake/worlds/*/water.json"], "url": "./docs/schemas/open-water.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/roads.json", "tools/OpenWorldBake/worlds/*/roads.json"], "url": "./docs/schemas/open-roads.schema.json" },
    { "fileMatch": ["PokemonPlatinumEngine/Data/world3d/*/places/*.json", "tools/OpenWorldBake/worlds/*/places/*.json"], "url": "./docs/schemas/open-place.schema.json" }
  ],
  // The files the game reads with comments and trailing commas allowed
  "files.associations": {
    "**/PokemonPlatinumEngine/Data/world/*/world.json": "jsonc",
    "**/PokemonPlatinumEngine/Data/world/*/overlays/*.json": "jsonc",
    "**/PokemonPlatinumEngine/Data/maps/*.json": "jsonc",
    "**/tools/DataImporter/Overrides/*.json": "jsonc",
    "**/PokemonPlatinumEngine/Data/world3d/**/*.json": "jsonc",
    "**/tools/OpenWorldBake/worlds/**/*.json": "jsonc"
  }
}
